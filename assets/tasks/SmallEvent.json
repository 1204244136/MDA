{
    "task": [
        {
            "name": "SmallEvent",
            "label": "$task.SmallEvent.label",
            "entry": "SmallEventMain",
            "description": "$task.SmallEvent.description",
            "group": [
                "periodic"
            ],
            "option": [
                "SmallEventTheme",
                "SmallEventChallenge",
                "SmallEventStory",
                "SmallEventMission"
            ]
        }
    ],
    "option": {
        "SmallEventTheme": {
            "type": "select",
            "label": "$option.SmallEventTheme.label",
            "cases": [
                {
                    "name": "CurrentEvent",
                    "label": "$option.SmallEventTheme.CurrentEvent",
                    "description": "$option.SmallEventTheme.CurrentEvent.description"
                },
                {
                    "name": "BitterSpice",
                    "label": "$option.SmallEventTheme.BitterSpice",
                    "pipeline_override": {
                        "SmallEventEnterMainPage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/BitterSpice/BitterSpiceLogo.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventClickStage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/BitterSpice/BitterSpiceStageNormal.png",
                                        "SmallEvent/BitterSpice/BitterSpiceStageNormalSP.png",
                                        "SmallEvent/BitterSpice/BitterSpiceStageHard.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventEventStageQuickBattleFlow": {
                            "next": [
                                "SmallEventBitterSpiceClickStageRepeatable",
                                "SmallEventGoBack"
                            ]
                        }
                    }
                },
                {
                    "name": "BSideIdol",
                    "label": "$option.SmallEventTheme.BSideIdol",
                    "pipeline_override": {
                        "SmallEventEnterMainPage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/B-SideIdol/B-SideIdolLogo.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventClickStage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/B-SideIdol/B-SideIdolStageNormal.png",
                                        "SmallEvent/B-SideIdol/B-SideIdolStageHard.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventEventStageQuickBattleFlow": {
                            "next": [
                                "SmallEventBSideIdolClickStageRepeatable",
                                "SmallEventGoBack"
                            ]
                        }
                    }
                },
                {
                    "name": "ProjectMatis",
                    "label": "$option.SmallEventTheme.ProjectMatis",
                    "pipeline_override": {
                        "SmallEventEnterMainPage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/ProjectMatis/ProjectMatisLogo.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventClickStage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/ProjectMatis/ProjectMatisStory1Stage.png",
                                        "SmallEvent/ProjectMatis/ProjectMatisStory2StageNormal.png",
                                        "SmallEvent/ProjectMatis/ProjectMatisStory2StageHard.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventEventStageQuickBattleFlow": {
                            "next": [
                                "SmallEventProjectMatisClickStageRepeatable",
                                "SmallEventGoBack"
                            ]
                        }
                    }
                },
                {
                    "name": "GreatVillainUnion",
                    "label": "$option.SmallEventTheme.GreatVillainUnion",
                    "pipeline_override": {
                        "SmallEventEnterMainPage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/GreatVillainUnion/GreatVillainUnionLogo.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventClickStage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/GreatVillainUnion/GreatVillainUnionStageNormal.png",
                                        "SmallEvent/GreatVillainUnion/GreatVillainUnionStageHard.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventEventStageQuickBattleFlow": {
                            "next": [
                                "SmallEventGreatVillainUnionClickStageRepeatable",
                                "SmallEventGoBack"
                            ]
                        }
                    }
                },
                {
                    "name": "LittleWitchTrick",
                    "label": "$option.SmallEventTheme.LittleWitchTrick",
                    "pipeline_override": {
                        "SmallEventEnterMainPage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/LittleWitchTrick/LittleWitchTrickLogo.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventClickStage": {
                            "recognition": {
                                "param": {
                                    "template": [
                                        "SmallEvent/LittleWitchTrick/LittleWitchTrickStageNormal.png",
                                        "SmallEvent/LittleWitchTrick/LittleWitchTrickStageHard.png"
                                    ]
                                }
                            }
                        },
                        "SmallEventEventStageQuickBattleFlow": {
                            "next": [
                                "SmallEventLittleWitchTrickClickStageNormalRepeatable",
                                "SmallEventLittleWitchTrickClickStageHardRepeatable",
                                "SmallEventGoBack"
                            ]
                        }
                    }
                },
                {
                    "name": "Other",
                    "label": "$option.SmallEventTheme.Other"
                }
            ],
            "default_case": "CurrentEvent"
        },
        "SmallEventChallenge": {
            "type": "switch",
            "label": "$option.SmallEventContent.SmallEventChallenge",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SmallEventEnterChallenge": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SmallEventEnterChallenge": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "SmallEventStory": {
            "type": "switch",
            "label": "$option.SmallEventContent.SmallEventStory",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SmallEventEnterStory": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SmallEventEnterStory": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "SmallEventMission": {
            "type": "switch",
            "label": "$option.SmallEventContent.SmallEventMission",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SmallEventEnterMission": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SmallEventEnterMission": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
