{
    "task": [
        {
            "name": "Shop",
            "label": "$task.Shop.label",
            "entry": "ShopMain",
            "description": "$task.Shop.description",
            "option": [
                "CommonShop",
                "UnionShop",
                "ArenaShop",
                "RecyclingShop",
                "BodyLabelShop"
            ],
            "group": [
                "daily"
            ]
        }
    ],
    "option": {
        "CommonShop": {
            "type": "switch",
            "default_case": "Yes",
            "label": "$option.CommonShop.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "CommonShopFreeGoods",
                        "CommonShopCoreDustCase",
                        "CommonShopProfileCustomPack",
                        "CommonShopDarlingForADay"
                    ],
                    "pipeline_override": {
                        "CommonShop": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonShop": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "CommonShopFreeGoods": {
            "type": "switch",
            "label": "$option.CommonShopFreeGoods.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ShopPurchaseFreeGoods": {
                            "enabled": true
                        },
                        "ShopClickFreeRefresh": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ShopPurchaseFreeGoods": {
                            "enabled": false
                        },
                        "ShopClickFreeRefresh": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
