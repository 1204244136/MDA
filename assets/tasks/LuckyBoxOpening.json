{
    "task": [
        {
            "name": "LuckyBoxOpening",
            "label": "$task.LuckyBoxOpening.label",
            "entry": "LuckyBoxOpeningMain",
            "description": "$task.LuckyBoxOpening.description",
            "group": [
                "utility"
            ],
            "doc": [
                "$task.LuckyBoxOpening.doc"
            ],
            "option": [
                "LuckyBoxOpeningUseRecruitmentItems"
            ]
        }
    ],
    "option": {
        "LuckyBoxOpeningUseRecruitmentItems": {
            "type": "switch",
            "label": "$option.LuckyBoxOpeningUseRecruitmentItems.label",
            "description": "$option.LuckyBoxOpeningUseRecruitmentItems.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "LuckyBoxOpeningUseRecruitmentItems": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "LuckyBoxOpeningUseRecruitmentItems": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
