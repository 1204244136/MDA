{
    "task": [
        {
            "name": "Advise",
            "label": "$task.Advise.label",
            "entry": "AdviseMain",
            "description": "$task.Advise.description",
            "group": [
                "daily"
            ],
            "option": [
                "NikkeAdvise",
                "AdviseEpisodeViewingReward"
            ]
        }
    ],
    "option": {
        "NikkeAdvise": {
            "type": "switch",
            "label": "$option.NikkeAdvise.label",
            "description": "$task.NikkeAdvise.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "AdviseEpisodeReward",
                        "AdviseFilterUpgradable"
                    ],
                    "pipeline_override": {
                        "AdviseEnterAdvisePage": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AdviseEnterAdvisePage": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AdviseEpisodeReward": {
            "type": "switch",
            "label": "$option.AdviseEpisodeReward.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AdviseEpisodeRewardEntry": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AdviseEpisodeRewardEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AdviseFilterUpgradable": {
            "type": "switch",
            "label": "$option.AdviseFilterUpgradable.label",
            "description": "$option.AdviseFilterUpgradable.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AdviseOpenFilterPopup": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AdviseOpenFilterPopup": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "AdviseEpisodeViewingReward": {
            "type": "switch",
            "label": "$option.AdviseEpisodeViewingReward.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AdviseEpisodeViewingEntry": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AdviseEpisodeViewingEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
