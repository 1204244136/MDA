    "RedDotClearNoticeClickItem": {
        "desc": "公告列表条目红点",
        "max_hit": 50, // 兜底防单个无法消除的条目红点反复死点
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    775,
                    133,
                    46,
                    489
                ], // 太长会导致点击卡片边缘失效
                "template": [
                    "Common/RedDot.png"
                ],
                "threshold": 0.75, // 实测真红点 0.800~0.957，插画误匹配最高 0.575
                "order_by": "Vertical"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -10,
                    10,
                    0,
                    0
                ]
