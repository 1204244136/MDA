    "RedDotClearNoticeEventTabDot": {
        "desc": "活动分页红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    605,
                    98,
                    35,
                    30
                ], // 限定左页签角标区域，避免混入右页签或触发水波纹遮挡
                "template": [
                    "Common/RedDot.png"
                ]
            }
        }
    },
    "RedDotClearNoticeSystemTabDot": {
        "desc": "系统分页红点",
