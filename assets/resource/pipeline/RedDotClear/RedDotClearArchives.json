{
    "RedDotClearArchives": {
        "desc": "清除档案馆红点",
        "max_hit": 1,
        "next": [
            "RedDotClearArchivesEnterHall",
            "[JumpBack]CommonReturnHall"
        ]
    },
    "RedDotClearArchivesEnterHall": {
        "desc": "档案馆入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "[JumpBack]RedDotClearClickMore",
            "RedDotClearArchivesClickEntry",
            "CommonClickBlank"
        ]
    },
    "RedDotClearArchivesClickEntry": {
        "desc": "点击档案馆红点",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArchivesVisible",
                    "ArchivesNew"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "RedDotClearArchivesFlow"
        ]
    },
    "ArchivesVisible": {
        "desc": "档案馆可见",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    120,
                    200,
                    260
                ],
                "template": [
                    "RedDotClear/Archives.png"
                ]
            }
        }
    },
    "ArchivesNew": {
        "desc": "档案馆有New的图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "ArchivesVisible",
                "roi_offset": [
                    20,
                    -20,
                    20,
                    20
                ],
                "template": [
                    "Common/New.png"
                ]
            }
        }
    },
    "RedDotClearArchivesFlow": {
        "desc": "档案馆流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArchivesEntered"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [
                475,
                165,
                330,
                515
            ],
            "rate_limit": 100,
            "timeout": 2000
        },
        "next": [
            "RedDotClearArchivesCleared",
            "ArchivesRedDotClickTop"
        ]
    },
    "ArchivesEntered": {
        "desc": "处于档案馆界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    ".*回.*" //回忆
                ]
            }
        }
    },
    "ArchivesRedDotClickBottom": {
        "desc": "档案馆底部点击红点", //实际上点的是活动奖励文本，因为红点在大面积下容易误判
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    461,
                    103,
                    358,
                    613
                ],
                "expected": [
                    ".*活动奖励.*"
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -10,
                    10,
                    0,
                    0
                ]
            }
        },
        "next": [
            "ArchivesClickUnlock"
        ]
    },
    "ArchivesRedDotLeft": {
        "desc": "档案馆左侧红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    476,
                    146,
                    18,
                    578
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        }
    },
    "ArchivesRedDotRight": {
        "desc": "档案馆右侧红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    784,
                    146,
                    21,
                    578
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        }
    },
    "ArchivesClickUnlock": {
        "desc": "档案馆点击解锁",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    623,
                    556,
                    69,
                    35
                ],
                "expected": [
                    ".*解锁.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "timeout": 30000,
        "next": [
            "[JumpBack]CommonConfirmReward",
            "[JumpBack]CommonConfirmAction",
            "[JumpBack]DialoguesSkipStory",
            "CommonClosePage",
            "[JumpBack]CommonGoBack",
            "[JumpBack]CommonTouchToContinue",
            "[JumpBack]RedDotClearArchivesDismissIntro"
        ]
    },
    "RedDotClearArchivesDismissIntro": {
        "desc": "未检测到左上角活动地区哨兵时，点击画面内空白处跳过首次活动封面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LargeEventMainPageEntered"
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    640,
                    650
                ]
            }
        }
    },
    "ArchivesRedDotClickTop": {
        "desc": "仅进入时点击剧情活动标签，后续翻页不重复点击",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    467,
                    118,
                    130,
                    33
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/New.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    535,
                    135
                ]
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [
                475,
                165,
                330,
                515
            ],
            "rate_limit": 100,
            "timeout": 2000
        },
        "next": [
            "RedDotClearArchivesScrollUp"
        ]
    },
    "RedDotClearArchivesScrollUp": {
        "desc": "进入剧情活动后连续大幅上滑，先前往最新活动所在的列表底部",
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    650
                ],
                "end": [
                    640,
                    180
                ],
                "end_hold": 100,
                "duration": 150
            }
        },
        "repeat": 30,
        "repeat_delay": 100,
        "post_wait_freezes": {
            "time": 200,
            "target": [
                475,
                165,
                330,
                515
            ],
            "rate_limit": 100,
            "timeout": 2000
        },
        "next": [
            "RedDotClearArchivesScanFlow"
        ]
    },
    "RedDotClearArchivesScanFlow": {
        "desc": "由最新活动向上检查；红点消失才结束，超过扫描上限仍有红点则超时报错",
        "max_hit": 40,
        "timeout": 5000,
        "rate_limit": 200,
        "next": [
            "RedDotClearArchivesCleared",
            "[JumpBack]ArchivesRedDotClickBottom",
            "RedDotClearArchivesScrollDown"
        ]
    },
    "ArchivesStoryNew": {
        "desc": "剧情活动标签仍有红点或 New",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    467,
                    118,
                    130,
                    33
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/New.png"
                ]
            }
        }
    },
    "RedDotClearArchivesCleared": {
        "desc": "外层已确认处于档案馆，且剧情活动红点已消失时正常返回",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    467,
                    118,
                    130,
                    33
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/New.png"
                ]
            }
        },
        "inverse": true,
        "next": [
            "CommonGoBack"
        ]
    },
    "RedDotClearArchivesScrollDown": {
        "desc": "有红点时反向逐页检查，保留视口重叠；最多 40 次，不以滑到顶作为成功条件",
        "max_hit": 40,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArchivesEntered",
                    "ArchivesStoryNew"
                ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    220
                ],
                "end": [
                    640,
                    600
                ],
                "end_hold": 200,
                "duration": 300
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [
                475,
                165,
                330,
                515
            ],
            "rate_limit": 100,
            "timeout": 2000
        },
        "next": [
            "RedDotClearArchivesScanFlow"
        ]
    }
}
