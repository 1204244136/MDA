{
    "RedDotClearCashShop": {
        "desc": "清除付费商店红点",
        "max_hit": 1,
        "next": [
            "RedDotClearCashShopEnterHall",
            "[JumpBack]CommonReturnHall"
        ]
    },
    "RedDotClearCashShopEnterHall": {
        "desc": "付费商店入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "RedDotClearCashShopClickEntry",
            "CommonEndTask"
        ]
    },
    "RedDotClearCashShopClickEntry": {
        "desc": "点击付费商店红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    418,
                    423,
                    22,
                    20
                ],
                "template": [
                    "Common/New.png",
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -20,
                    20,
                    0,
                    0
                ]
            }
        },
        "next": [
            "RedDotClearCashShopFlow"
        ]
    },
    "RedDotClearCashShopFlow": {
        "desc": "付费商店流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CashShopMainPageEntered"
                ]
            }
        },
        "next": [
            "[JumpBack]CashShopConsumeLimitFlow",
            "[JumpBack]RedDotClearClickCashShopNew",
            "[JumpBack]RedDotClearCashShopActivityRedDot",
            "CommonEndTask"
        ]
    },
    "RedDotClearClickCashShopNew": {
        "desc": "付费商店点击红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    3,
                    140,
                    883,
                    124
                ],
                "template": [
                    "Common/New.png",
                    "Common/RedDot.png"
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -20,
                    20,
                    0,
                    0
                ]
            }
        },
        "next": [
            "[JumpBack]RedDotClearPurchaseStepUpPackage",
            "RedDotClearClickCashShopNew",
            "CommonEndTask"
        ]
    },
    "RedDotClearCashShopActivityRedDot": {
        "desc": "清除付费商店右侧累充活动入口红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1200,
                    55,
                    80,
                    90
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    //红点贴在横幅右上角，往左下方偏移点到横幅本体
                    -21,
                    11,
                    0,
                    0
                ]
            }
        },
        "next": [
            "RedDotClearCashShopActivityPageVisible"
        ]
    },
    "RedDotClearCashShopActivityPageVisible": {
        "desc": "付费商店累充活动页可见",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    220,
                    80
                ],
                "expected": [
                    "点数活动"
                ]
            }
        },
        "next": [
            "[JumpBack]RedDotClearCashShopActivityReward",
            "CommonGoBack"
        ]
    },
    "RedDotClearCashShopActivityReward": {
        "desc": "领取付费商店累充活动红点奖励",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    330,
                    100,
                    620,
                    520
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    //红点在奖励图标右上角，往左下方偏移点到图标本体
                    -20,
                    8,
                    0,
                    0
                ]
            }
        },
        "next": [
            "CommonConfirmReward"
        ]
    },
    "RedDotClearPurchaseStepUpPackage": {
        "desc": "购买StepUp礼包",
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    783,
                    389,
                    49,
                    28
                ],
                "expected": [
                    "免费"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CommonConfirmReward"
        ]
    }
}
