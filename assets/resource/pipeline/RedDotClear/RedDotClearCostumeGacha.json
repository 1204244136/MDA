{
    "RedDotClearCostumeGacha": {
        "desc": "清除时装抽取红点",
        "max_hit": 1,
        "next": [
            "RedDotClearCostumeGachaEnterHall",
            "[JumpBack]CommonReturnHall"
        ]
    },
    "RedDotClearCostumeGachaEnterHall": {
        "desc": "时装抽取入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "RedDotClearCostumeGachaClickEntry",
            "CommonEndTask"
        ]
    },
    "RedDotClearCostumeGachaClickEntry": {
        "desc": "点击时装抽取红点",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaVisible",
                    "CostumeGachaNewOrRedDot"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "RedDotClearCostumeGachaFlow"
        ]
    },
    "CostumeGachaVisible": {
        "desc": "时装抽取可见",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    120,
                    200,
                    260
                ],
                "template": [
                    "RedDotClear/CostumeGacha.png"
                ],
                "threshold": 0.8
            }
        }
    },
    "CostumeGachaNewOrRedDot": {
        "desc": "时装抽取有New或红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "CostumeGachaVisible",
                "roi_offset": [
                    10,
                    -20,
                    20,
                    20
                ],
                "template": [
                    "Common/New.png",
                    "Common/RedDot.png"
                ]
            }
        }
    },
    "RedDotClearCostumeGachaFlow": {
        "desc": "时装抽取流程", // 每次切换时装重入，有票券商店红点先领免费票，无红点直接抽取
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "时装抽取"
                ]
            }
        },
        "next": [
            "CostumeGachaEnterTicketShop",
            "CostumeGachaClickGacha"
        ]
    },
    "CostumeGachaEnterTicketShop": {
        "desc": "有红点时进入票券商店",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    690,
                    40,
                    40,
                    35
                ], // 仅匹配按钮右上角红点，避开按钮文字随图标宽度漂移
                "template": [
                    "Common/RedDot9x9.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -60,
                    12,
                    0,
                    0
                ] // 从右上角红点向左下偏移到票券商店按钮内
            }
        },
        "next": [
            "CostumeGachaPurchaseFreeTicketFlow"
        ]
    },
    "CostumeGachaPurchaseFreeTicketFlow": {
        "desc": "购买免费票券流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "票券商店"
                ]
            }
        },
        "post_wait_freezes": 200,
        "next": [
            "CostumeGachaPurchaseFreeTicket",
            "CostumeGachaReturnGachaPage"
        ]
    },
    "CostumeGachaPurchaseFreeTicket": {
        "desc": "购买免费票券",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    7,
                    263,
                    641,
                    182
                ],
                "expected": [
                    ".*免费.*"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    -20,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]CommonConfirmAction",
            "[JumpBack]CommonConfirmReward",
            "CostumeGachaReturnGachaPage"
        ]
    },
    "CostumeGachaReturnGachaPage": {
        "desc": "返回时装抽取页面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "票券商店"
                ]
            }
        },
        "next": [
            "CostumeGachaClickGacha", // 确认回到抽取页再开始抽，避免误二次点返回退回大厅
            "[JumpBack]CommonGoBack"
        ]
    },
    "CostumeGachaClickGacha": {
        "desc": "点击抽取",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    607,
                    100,
                    33
                ],
                "expected": [
                    "抽取"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 300, // 去掉转盘页易卡住的冻结等待并缩短轮询，以便及时点掉 SKIP
        "next": [
            "CostumeGachaCancelShopPrompt",
            "[JumpBack]CommonSkipPlot",
            "CostumeGachaConfirmPullReward" // 领完本次奖励再回到抽取，避免退场期重复误点 SKIP
        ]
    },
    "CostumeGachaConfirmPullReward": {
        "desc": "确认时装抽取奖励",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonConfirmReward"
                ]
            }
        },
        "pre_wait_freezes": 500,
        "action": {
            "type": "Click"
        },
        "next": [
            "CostumeGachaClickGacha",
            "CostumeGachaConfirmPullReward" // 领奖弹窗未收起时重试，不含跳过节点以免退场期误点 SKIP
        ]
    },
    "CostumeGachaCancelShopPrompt": {
        "desc": "取消前往票券商店弹窗",
        "max_hit": 20, // 兜底防弹窗关闭异常时无限重试
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonCancelOptionVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500, // 仅等待静态票券商店按钮恢复高亮稳定，避开背景 Live2D 动画
            "rate_limit": 200,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "CostumeGachaCancelShopPrompt", // 弹窗未关闭时重点击，避免暗态下误判右箭头不可用
            "CostumeGachaClickNext",
            "CommonEndTask"
        ]
    },
    "CostumeGachaClickNext": {
        "desc": "切换下一套时装",
        "max_hit": 15, // 限制最大切换次数，防止箭头异常卡死时无限循环
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaNextArrowVisible",
                    "CostumeGachaNextArrowAvailable"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500, // 仅等待静态票券商店按钮切换稳定，避开背景 Live2D 动画
            "rate_limit": 200,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "RedDotClearCostumeGachaFlow"
        ]
    },
    "CostumeGachaNextArrowVisible": {
        "desc": "右侧切换箭头可见", // 框选范围贴紧箭头并避开左侧卡池横幅边框
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    733,
                    508,
                    28,
                    36
                ],
                "template": [
                    "RedDotClear/CostumeGachaNextArrow.png"
                ]
            }
        }
    },
    "CostumeGachaNextArrowAvailable": {
        "desc": "右侧切换箭头可点击", // 亮白表示可切换，过滤变黑到底态与弹窗遮罩暗态
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "CostumeGachaNextArrowVisible",
                "lower": [
                    200,
                    200,
                    200
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 40
            }
        }
    }
}
