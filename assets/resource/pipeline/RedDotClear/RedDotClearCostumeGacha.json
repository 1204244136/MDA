{
    "RedDotClearCostumeGacha": {
        "desc": "清除时装抽取红点",
        "max_hit": 1,
        "next": [
            "RedDotClearCostumeGachaEnterHall",
            "[JumpBack]CommonReturnHall"
        ]
    },
    "RedDotClearCostumeGachaEnterHall": {
        "desc": "时装抽取入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "RedDotClearCostumeGachaClickEntry",
            "CommonEndTask"
        ]
    },
    "RedDotClearCostumeGachaClickEntry": {
        "desc": "点击时装抽取红点",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaVisible",
                    "CostumeGachaNewOrRedDot"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "RedDotClearCostumeGachaFlow"
        ]
    },
    "CostumeGachaVisible": {
        "desc": "时装抽取可见",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    120,
                    200,
                    260
                ],
                "template": [
                    "RedDotClear/CostumeGacha.png"
                ],
                "threshold": 0.8
            }
        }
    },
    "CostumeGachaNewOrRedDot": {
        "desc": "时装抽取有New的图标或红点",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CostumeGachaNew",
                    "CostumeGachaRedDot"
                ]
            }
        }
    },
    "CostumeGachaNew": {
        "desc": "时装抽取有New的图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "CostumeGachaVisible",
                "roi_offset": [
                    10,
                    -20,
                    20,
                    20
                ],
                "template": [
                    "Common/New.png"
                ]
            }
        }
    },
    "CostumeGachaRedDot": {
        "desc": "时装抽取有红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "CostumeGachaVisible",
                "roi_offset": [
                    10,
                    -20,
                    20,
                    20
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        }
    },
    "RedDotClearCostumeGachaFlow": {
        "desc": "时装抽取流程", // 每次切换时装都会重入，先查当前套票券商店再进入抽取循环
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaEntered"
                ]
            }
        },
        "next": [
            "CostumeGachaEnterTicketShop"
        ]
    },
    "CostumeGachaEntered": {
        "desc": "处于时装抽取界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "时装抽取"
                ]
            }
        }
    },
    "CostumeGachaEnterTicketShop": {
        "desc": "进入时装抽取票券商店",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    538,
                    55,
                    179,
                    23
                ],
                "expected": [
                    ".*票券商店.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CostumeGachaPurchaseFreeTicketFlow"
        ]
    },
    "CostumeGachaPurchaseFreeTicketFlow": {
        "desc": "购买免费票券流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "票券商店"
                ]
            }
        },
        "post_wait_freezes": 200,
        "next": [
            "CostumeGachaPurchaseFreeTicket",
            "CostumeGachaReturnGachaPage"
        ]
    },
    "CostumeGachaPurchaseFreeTicket": {
        "desc": "购买免费票券",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    7,
                    263,
                    641,
                    182
                ],
                "expected": [
                    ".*免费.*"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    -20,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]CommonConfirmAction",
            "[JumpBack]CommonConfirmReward",
            "CostumeGachaReturnGachaPage"
        ]
    },
    "CostumeGachaReturnGachaPage": {
        "desc": "返回时装抽取页面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "票券商店"
                ]
            }
        },
        "next": [
            "CostumeGachaPullFlow", // 先确认已回到时装抽取页，避免误二次点返回退回大厅
            "[JumpBack]CommonGoBack"
        ]
    },
    "CostumeGachaPullFlow": {
        "desc": "当前时装抽取流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaEntered"
                ]
            }
        },
        "next": [
            "CostumeGachaClickGacha"
        ]
    },
    "CostumeGachaButtonVisible": {
        "desc": "抽取按钮可见", // 抽成子节点供外层组合引用，避免与奖励确认节点合并批量识别导致浅色底误识
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    607,
                    100,
                    33
                ],
                "expected": [
                    "抽取"
                ]
            }
        }
    },
    "CostumeGachaClickGacha": {
        "desc": "点击抽取",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaButtonVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "next": [
            "CostumeGachaCancelShopPrompt",
            "[JumpBack]CommonSkipPlot",
            "[JumpBack]CommonConfirmReward",
            "CostumeGachaClickGacha" // 抽完继续抽当前套，直到票券不足弹窗出现再切下一套
        ]
    },
    "CostumeGachaTicketShortageVisible": {
        "desc": "票券不足前往商店提示可见", // 覆盖弹窗两行文案，任一行命中即成立
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    520,
                    285,
                    240,
                    85
                ],
                "expected": [
                    ".*票券不足.*",
                    ".*前往商店.*"
                ]
            }
        }
    },
    "CostumeGachaCancelShopPrompt": {
        "desc": "取消前往票券商店弹窗",
        "max_hit": 20, // 兜底防弹窗关闭异常时无限重试
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonCancelOptionVisible", // 放首位使点击落在取消按钮上
                    "CostumeGachaTicketShortageVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500, // 仅等待静态票券商店按钮恢复高亮稳定，避开背景 Live2D 动画
            "rate_limit": 200,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "CostumeGachaCancelShopPrompt", // 弹窗未关闭时重点击，避免暗态下误判右箭头不可用
            "CostumeGachaClickNext",
            "CommonEndTask"
        ]
    },
    "CostumeGachaClickNext": {
        "desc": "切换下一套时装",
        "max_hit": 15, // 限制最大切换次数，防止箭头异常卡死时无限循环
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CostumeGachaNextArrowVisible",
                    "CostumeGachaNextArrowAvailable"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500, // 仅等待静态票券商店按钮切换稳定，避开背景 Live2D 动画
            "rate_limit": 200,
            "target": [
                588,
                57,
                74,
                19
            ]
        },
        "next": [
            "RedDotClearCostumeGachaFlow"
        ]
    },
    "CostumeGachaNextArrowVisible": {
        "desc": "右侧切换箭头可见", // 框选范围贴紧箭头并避开左侧卡池横幅边框
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    733,
                    508,
                    28,
                    36
                ],
                "template": [
                    "RedDotClear/CostumeGachaNextArrow.png"
                ]
            }
        }
    },
    "CostumeGachaNextArrowAvailable": {
        "desc": "右侧切换箭头可点击", // 亮白表示可切换，过滤变黑到底态与弹窗遮罩暗态
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "CostumeGachaNextArrowVisible",
                "lower": [
                    200,
                    200,
                    200
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 40
            }
        }
    }
}
