{
    "MapPushingFlow": {
        "desc": "推图流程",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "[JumpBack]CommonCloseSale",
            "MapPushingEnterCampaign",
            "MapPushingEnterCampaignCovered",
            "[JumpBack]MapPushingHardFallback",
            "[JumpBack]MapPushingCloseExpandedMap",
            "[JumpBack]MapPushingCloseMail",
            "[JumpBack]CrossChapterBattleResumed",
            "[JumpBack]CrossChapterCompletion",
            "[JumpBack]CrossChapterCloseList",
            "[JumpBack]MapPushingResumeSettlement",
            "[JumpBack]BattleDismissLevelUp",
            "[JumpBack]BattleDismissOutpostLevelUp",
            "[JumpBack]BattleEntryFlow",
            "[JumpBack]CommonSkipPlot",
            "[JumpBack]MapPushingWaitForBattle",
            "[JumpBack]MapPushingClickMonster",
            "[JumpBack]MapPushingClickPlate",
            "[JumpBack]MapPushingSweep"
        ],
        "focus": {
            "Node.Action.Succeeded": "$focus.MapPushingFlow.Action.Succeeded"
        }
    },
    "MapPushingClickMonsterRaw": {
        "desc": "推图怪物原始识别",
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "model": "MapPushing.onnx",
                "expected": [
                    0
                ]
            }
        }
    },
    "MapPushingMapTitle": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    110,
                    52
                ],
                "expected": [
                    "野.*"
                ]
            }
        }
    },
    "MapPushingExpandedMapCorner": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    782,
                    173,
                    44,
                    51
                ],
                "template": [
                    "MapPushing/ExpandedMapCorner.png"
                ],
                "threshold": 0.9
            }
        }
    },
    "MapPushingExpandedMapZoom": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    453,
                    173,
                    46,
                    49
                ],
                "template": [
                    "MapPushing/ExpandedMapZoom.png"
                ],
                "threshold": 0.9
            }
        }
    },
    "MapPushingExpandedMapVisible": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MapPushingExpandedMapCorner",
                    "MapPushingExpandedMapZoom"
                ]
            }
        }
    },
    "MapPushingCloseExpandedMap": {
        "desc": "小地图弹窗关闭后恢复一次拖图，机关节点保持原样",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MapPushingExpandedMapVisible"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    798,
                    188,
                    12,
                    12
                ]
            }
        },
        "post_delay": 500,
        "next": [
            "MapPushingFlow"
        ]
    },
    "MapPushingMailTitle": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    585,
                    80,
                    100,
                    45
                ],
                "expected": [
                    "邮箱"
                ]
            }
        }
    },
    "MapPushingMailCollect": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    665,
                    580,
                    145,
                    55
                ],
                "expected": [
                    "全部领取"
                ]
            }
        }
    },
    "MapPushingMailVisible": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MapPushingMailTitle",
                    "MapPushingMailCollect"
                ]
            }
        }
    },
    "MapPushingCloseMail": {
        "desc": "确认邮箱弹窗后只关闭，不领取或删除邮件",
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MapPushingMailVisible"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    786,
                    94,
                    18,
                    18
                ]
            }
        },
        "post_delay": 600
    },
    "MapPushingClickMonster": {
        "desc": "推图点击怪物",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ClassifiedMonsterRecognition",
                "custom_recognition_param": {
                    "entry": "MapPushingClickMonsterRaw",
                    "boss": "MapPushingBossMarker",
                    "ex": "MapPushingExMarker"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                448,
                512,
                385,
                79
            ]
        }
    },
    "MapPushingBossMarker": {
        "desc": "红色亮光骷髅头 Boss 标识",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapPushingBossRecognition"
            }
        }
    },
    "MapPushingExMarker": {
        "desc": "三角形 EX 标识",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    1280,
                    720
                ],
                "template": [
                    "MapPushing/ExTriangle.png",
                    "MapPushing/ExTriangleLeft.png",
                    "MapPushing/ExTriangleLeftNear.png",
                    "MapPushing/ExTriangle44.png",
                    "MapPushing/ExGlow45.png",
                    "MapPushing/ExGlow45Dim.png"
                ],
                "threshold": 0.86
            }
        }
    },
    "MapPushingBossRaw": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "model": "MapPushing.onnx",
