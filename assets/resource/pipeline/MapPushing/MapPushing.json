                    1
                ]
            }
        }
    },
    "MapPushingBossIcon": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    1280,
                    640
                ],
                "template": [
                    "MapPushing/BossMarkNear.png",
                    "MapPushing/BossMarkFar.png",
                    "MapPushing/BossMarkOccluded.png",
                    "MapPushing/BossMarkLeft.png"
                ],
                "threshold": 0.5
            }
        }
    },
    "MapPushingSweep": {
        "desc": "无可点击目标或点击无进展时连续拖图探索",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapPushingSweepReady"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapPushingSweep"
            }
        },
        "post_delay": 900
    },
    "MapPushingWaitForBattle": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapPushingWaitingForBattle"
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 500
    },
    "MapPushingPan": {
        "desc": "拖动平移镜头：方向与地图内容位移一致，起止点避开已识别目标",
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    1000,
                    510
                ],
                "end": [
                    520,
                    510
                ],
                "duration": 400,
                "end_hold": 0,
                "only_hover": false,
                "contact": 0
            }
        },
        "post_wait_freezes": 350
    },
    "MapPushingResumeSettlement": {
        "desc": "从已显示的战役结算页恢复推图",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleSettlementEscVisible",
                    "MapPushingSettlementStage"
                ]
            }
        },
        "next": [
            "BattleConfirmOperationComplete"
        ]
    },
    "MapPushingSettlementStage": {
        "desc": "结算页中的战役关卡编号及 STAGE/BOSS 标题",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    440,
                    390,
                    400,
                    90
                ],
                "expected": [
                    "[0-9]+\\s*[-–—]\\s*[0-9]+\\s*(HARD\\s*)?(STAGE|B[O0]SS)"
                ]
            }
        }
    },
    "MapPushingClickPlateRaw": {
