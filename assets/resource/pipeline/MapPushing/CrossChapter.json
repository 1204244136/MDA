  "CrossChapterWaitList": {
    "desc": "等待章节列表出现",
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "CrossChapterListTitle"
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "post_delay": 300,
    "next": [
      "CrossChapterNormalTabClick"
    ]
  },
