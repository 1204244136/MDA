{
  "CrossChapterBattleResumed": {
    "desc": "新地图点怪后核对战斗 HUD，成功仍留在战斗流程",
    "enabled": true,
    "recognition": {
      "type": "Custom",
      "param": {
        "custom_recognition": "CrossChapterGate",
        "custom_recognition_param": {
          "resume_only": true
        }
      }
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "CrossChapterStep"
      }
    },
    "post_delay": 400
  },
  "CrossChapterClearMark": {
