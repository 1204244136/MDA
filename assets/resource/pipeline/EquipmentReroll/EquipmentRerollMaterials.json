{
    "__EquipmentRerollLockConfirmEnabled": {
        "desc": "锁定确认按钮已亮", // 确认按钮在锁定页底部，485,590 起的 70×25 区域
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    485,
                    590,
                    70,
                    25
                ],
                "method": 40,
                "lower": [
                    85,
                    140,
                    150
                ],
                "upper": [
                    115,
                    255,
                    255
                ],
                "count": 900 // 框内约一半像素变蓝才算启用；未选材料时按钮是灰的，达不到 900
            }
        }
    },
    "__EquipmentRerollLockConfirmText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    590,
                    585,
                    100,
                    45
                ],
                "expected": "确认"
            }
        }
    },
    "__EquipmentRerollCostModule": {
        "desc": "消耗栏模组图标", // 只框黑色消耗汇总条那一行：上方「必要数量」行与下方库存图标外形相近，框大了会串
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    610,
                    487,
                    100,
                    32
                ],
                "template": "EquipmentReroll/CostModule.png",
                "threshold": 0.8
            }
        }
    },
    "__EquipmentRerollCostKey": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    655,
                    487,
                    65,
                    32
                ],
                "template": "EquipmentReroll/CostKey.png",
                "threshold": 0.8
            }
        }
    },
    "__EquipmentRerollCostModuleCount": {
        "desc": "消耗栏模组数量", // 相对模组图标右移 20px、上探 3px 取数字，高度 +6 盖住小字
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__EquipmentRerollCostModule",
                "roi_offset": [
                    20,
                    -3,
                    4,
                    6
                ],
                "expected": "^\\d+$",
                "only_rec": true // 必须 only_rec：小字走 det 只能框住数字上半部，下半截丢失
            }
        }
    },
    "__EquipmentRerollCostKeyCount": {
        "desc": "消耗栏密钥数量", // 相对密钥图标右移 24px：密钥可能两位，比模组多留 4px
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__EquipmentRerollCostKey",
                "roi_offset": [
                    24,
                    -3,
                    4,
                    6
                ],
                "expected": "^\\d+$", // ^\d+$ 允许两位密钥数，不强求单字符
                "only_rec": true // 同模组数量：小字必须 only_rec
            }
        }
    },
    "__EquipmentRerollHeldLabel": {
        "desc": "持有材料标签",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    505,
                    240,
                    45
                ],
                "expected": "持有材料" // 只当相对定位的锚点文字用，不单独判定成败
            }
        }
    },
    "__EquipmentRerollConfirmHeldModule": {
        "desc": "持有模组库存", // 相对「持有材料」右移 65px，只框第一种材料（模组）的库存区；千位分隔符三种写法（1,234 / 1.234 / 1，234）统一剥掉再转整数
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__EquipmentRerollHeldLabel",
                "roi_offset": [
                    65,
                    -4,
                    40,
                    10
                ],
                "expected": "^\\d+$",
                "replace": [
                    [
                        "[.,，]",
                        ""
                    ]
                ],
                "order_by": "Horizontal", // 标签右侧先出现材料图标，图标里的小数字会被误读；取最右一段才是库存
                "index": -1
            }
        }
    }
}
