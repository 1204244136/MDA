        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollScanSlot3"
        ]
    },
    "EquipmentRerollScanSlot3": {
        "desc": "全量扫描第3栏：词条/数值/锁定（复用 Pipeline 子识别，Go 记录业务，完成后路由下一部位）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollScanSlotRecognition",
                "custom_recognition_param": {
                    "slot": 3,
                    "is_last": true
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollScanRouteAction",
                "custom_action_param": {
                    "slot": 3,
                    "is_last": true
                }
            }
        },
        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 100,
        "next": [
            "[JumpBack]EquipmentRerollScanCloseDetails",
            "EquipmentRerollDecide"
        ]
    },
    "__EquipmentRerollSlot1AffixOCR": {
        "desc": "第1槽词条区域 OCR（Flag 锚点 + offset，宽 150）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "[Anchor]EquipmentRerollInspectFlag",
                "roi_offset": [
                    -90,
                    45,
                    136,
                    7
                ],
                "expected": [
                    ".*"
                ],
                "only_rec": true
            }
        }
    },
