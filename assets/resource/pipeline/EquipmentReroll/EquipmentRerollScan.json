                    "part": "腿部"
                }
            }
        },
        "post_delay": 0,
        "next": [
            "__EquipmentRerollLocateFlag"
        ]
    },
    "__EquipmentRerollLocateFlag": {
        "desc": "装备详情页锚点定位：Flag 小图标，用于按固定 offset 推导三个槽位",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    480,
                    400,
                    200,
                    90
                ],
                "template": [
                    "EquipmentReroll/InspectFlag.png"
                ],
                "threshold": 0.9,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "anchor": "EquipmentRerollInspectFlag",
        "post_delay": 0,
        "next": [
            "EquipmentRerollScanSlot1"
        ]
    },
    "EquipmentRerollScanSlot1": {
        "desc": "全量扫描第1栏：词条/数值/锁定（复用 Pipeline 子识别，Go 记录业务）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollScanSlotRecognition",
                "custom_recognition_param": {
                    "slot": 1,
                    "is_last": false
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollScanSlot2"
        ]
    },
    "EquipmentRerollScanSlot2": {
        "desc": "全量扫描第2栏：词条/数值/锁定（复用 Pipeline 子识别，Go 记录业务）",
