{
    "EquipmentRerollScanMain": {
        "desc": "从详情资讯页面开始检查四个部位的装备",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "EquipmentRerollScanDetailsPageEntered"
        ]
    },
    "EquipmentRerollScanDetailsPageEntered": {
        "desc": "确认处于详情资讯页面，并把打开详情页的路由锚点指向检查词条的处理入口",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "详情资讯"
                ]
            }
        },
        "pre_delay": 0,
        "anchor": {
            "EquipmentRerollAfterOpenHead": "EquipmentRerollScanBeginHead",
            "EquipmentRerollAfterOpenArms": "EquipmentRerollScanBeginArms",
            "EquipmentRerollAfterOpenTorso": "EquipmentRerollScanBeginTorso",
            "EquipmentRerollAfterOpenLegs": "EquipmentRerollScanBeginLegs"
        },
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollOpenHeadDetails"
        ]
    },
    "EquipmentRerollScanBeginHead": {
        "desc": "初始化头部词条扫描",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollScanBeginAction",
                "custom_action_param": {
                    "part": "头部"
                }
            }
        },
        "post_delay": 0,
        "next": [
            "__EquipmentRerollLocateFlag"
        ]
    },
    "EquipmentRerollScanBeginArms": {
        "desc": "初始化臂部词条扫描",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollScanBeginAction",
                "custom_action_param": {
                    "part": "臂部"
                }
            }
        },
        "post_delay": 0,
        "next": [
            "__EquipmentRerollLocateFlag"
        ]
    },
    "EquipmentRerollScanBeginTorso": {
        "desc": "初始化身躯词条扫描",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollScanBeginAction",
                "custom_action_param": {
                    "part": "身躯"
                }
            }
        },
        "post_delay": 0,
