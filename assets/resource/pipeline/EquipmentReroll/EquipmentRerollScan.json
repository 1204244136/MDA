    "EquipmentRerollScanFailed": {
        "desc": "无法确认词条或页面已失效时停止，不提交不完整快照",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollFailAction", // reason 决定 i18n 文案（maafocus 大字提示），失败前会清掉待锁、待洗费用与未提交的数值方案
                "custom_action_param": {
                    "reason": "scan_unreadable"
                }
            }
        }
    }
