    "__EquipmentRerollRetryGateHeadDetailsOpened": {
        "desc": "重试闸门：点击头部装备后详情页没出现时有界重试，超限后显式失败",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollRetryGateAction",
                "custom_action_param": {
                    "key": "head_details_opened",
                    "retry": "EquipmentRerollOpenHeadDetails",
                    "give_up": "EquipmentRerollDetailsPageFailed",
                    "limit": 5,
                    "window_ms": 12000,
                    "next": [
                        "EquipmentRerollOpenHeadDetails",
                        "__EquipmentRerollRetryGateHeadDetailsOpened"
                    ]
                }
            }
        },
        "post_delay": 300,
        "timeout": 5000,
        "rate_limit": 500
    },
