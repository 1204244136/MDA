{
    "EquipmentRerollOpenHeadDetails": {
        "desc": "打开头部装备详情（检查词条 / 洗词条共用）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1068,
                    476,
                    167,
                    153
                ],
                "template": [
                    "EquipmentReroll/Head_Attacker.png",
                    "EquipmentReroll/Head_Defender.png",
                    "EquipmentReroll/Head_Supporter.png"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 500,
        "next": [
            "EquipmentRerollHeadDetailsEntered"
        ],
        "on_error": [
            "EquipmentRerollDetailsPageFailed"
        ]
    },
    "EquipmentRerollHeadDetailsEntered": {
