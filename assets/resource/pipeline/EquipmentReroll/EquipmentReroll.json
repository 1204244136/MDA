            "param": {
                "roi": [
                    460,
                    380,
                    240,
                    130
                ],
                "template": [
                    "EquipmentReroll/InspectFlag.png"
                ],
                "threshold": 0.9,
                "order_by": "Score"
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockRouteSlot"
