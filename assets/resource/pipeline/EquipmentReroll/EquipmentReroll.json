        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__EquipmentRerollChangeEffectTitle"
                ]
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollKeepLockRoute"
        ]
    },
