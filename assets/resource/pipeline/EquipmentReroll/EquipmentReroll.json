            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollLockDoneAction"
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockAfterRoute"
        ]
    },
    "EquipmentRerollLockAfterRoute": {
        "desc": "锁定完成分流：确认页特征优先，避免详情页 InspectFlag 在确认页误命中；确认页流程回确认页刷新，详情页流程回详情页刷新",
        "next": [
