    "__EquipmentRerollResultPageTitle": {
        "desc": "内部识别：确认效果变更结果页（OPTION CHANGE 标题），仅供 Go 复用",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    110,
                    210,
                    65
                ],
                "expected": [
                    "OPTION CHANGE"
                ]
            }
        }
    },
    "__EquipmentRerollResultChangedEffectSlot1": {
        "desc": "内部识别：读取结果页变更效果第1栏（引用第1变更槽锚点，精确位置），仅供 Go 复用",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "[Anchor]EquipmentRerollChangedSlot1",
                "roi_offset": [
                    0,
                    0,
                    155,
                    0
                ],
                "expected": [
                    ".*"
                ],
                "only_rec": true,
                "threshold": 0.3
            }
        }
    },
