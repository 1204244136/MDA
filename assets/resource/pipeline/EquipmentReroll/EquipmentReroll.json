{
    "EquipmentRerollMain": {
        "desc": "洗词条任务入口：从详情资讯页面开始，先识别四件装备，再按自定义配额执行效果变更",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "EquipmentRerollFlow"
        ]
    },
    "EquipmentRerollEnd": {
        "desc": "洗词条结束：四件装备均已满足自定义配额目标，或操作次数预算耗尽"
    },
    "EquipmentRerollFinalSummary": {
        "desc": "结束前通过 focus 输出人类可读摘要（装备详情含档位 + 库存）",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollFinalSummaryAction",
                "custom_action_param": {}
            }
        },
        "next": [
            "EquipmentRerollEnd"
        ]
    },
    "EquipmentRerollFlow": {
        "desc": "共用编排：校验大类与模式，扫描角色四件或选定单件，再分发效果/数值决策",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollConfigCheckAction"
            }
        },
        "next": [
            "EquipmentRerollScanMain"
        ]
    },
    "EquipmentRerollSingleScanRoute": {
        "desc": "单件模式扫描起点（Go）：跳过其余三件，直接打开 attach.part 选定的那一件装备详情",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollSingleScanRouteAction"
            }
        },
        "next": [
            "EquipmentRerollEnd"
        ]
    },
    "EquipmentRerollDecide": {
        "desc": "决策分发：设锚点到锁定检查，先判断全部完成，再通过全局有限步前瞻选择收益最高的部位（自定义配额）",
        "anchor": {
            "EquipmentRerollAfterOpenHead": "EquipmentRerollLockGate",
            "EquipmentRerollAfterOpenArms": "EquipmentRerollLockGate",
            "EquipmentRerollAfterOpenTorso": "EquipmentRerollLockGate",
            "EquipmentRerollAfterOpenLegs": "EquipmentRerollLockGate"
        },
        "next": [
            "EquipmentRerollAllSatisfied",
            "EquipmentRerollChoosePart",
            "EquipmentRerollEnd"
        ]
    },
    "EquipmentRerollChoosePart": {
        "desc": "全局有限步前瞻：从四件装备中选择期望收益最高的部位并直接打开对应详情页",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollChoosePartAction",
                "custom_action_param": {}
            }
        },
        "next": [
            "EquipmentRerollEnd"
        ]
    },
    "EquipmentRerollAllSatisfied": {
        "desc": "四件装备均满足自定义配额目标 → 结束",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollPartNeedRecognition",
                "custom_recognition_param": {
                    "part": "all",
                    "global_quota": {
                        "优越代码伤害增加": 4
                    }
                }
            }
        },
        "next": [
            "EquipmentRerollFinalSummary"
        ]
    },
    "EquipmentRerollLockGate": {
        "desc": "锁定检查入口：Flag 锚定后按自定义配额策略判定是否需锁定 2/3号槽位",
        "next": [
            "__EquipmentRerollLockLocateFlag"
        ]
    },
    "__EquipmentRerollLockLocateFlag": {
        "desc": "洗练锁定前 Flag 锚点定位（阈值0.3，确认页后重入偏暗需freeze）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    460,
                    380,
                    240,
                    130
                ],
                "template": [
                    "EquipmentReroll/InspectFlag.png"
                ],
                "threshold": 0.3,
                "order_by": "Score"
            }
        },
        "anchor": "EquipmentRerollInspectFlag",
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockBranch"
        ]
    },
    "EquipmentRerollLockBranch": {
        "desc": "锁定分支：优先尝试锁定 2/3号，不需锁定则直接效果变更",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "EquipmentRerollLockNeed",
            "EquipmentRerollClickChangeEffect"
        ]
    },
    "EquipmentRerollLockNeed": {
        "desc": "配置承载点 + 锁定判定：全部任务选项写在本节点 attach 顶层键（mode/part/wantN/slotN/quota_<效果名>，attach 按 key 合并互不覆盖）；命中→锁定流程",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollLockCheckRecognition",
                "custom_recognition_param": {
                    "global_quota": {
                        "优越代码伤害增加": 4
                    }
                }
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockRouteSlot"
        ]
    },
    "EquipmentRerollLockRouteSlot": {
        "desc": "锁定路由（Go）：新版客户端装备详情页词条行已不可点击，统一改走「点效果变更 → 确认页」，再由确认页的 KeepLock 分支完成锁定",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollLockRouteSlotAction"
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollClickChangeEffect"
        ]
    },
    "EquipmentRerollLockPageEntered": {
        "desc": "原子节点：确认进入效果锁定页（复用 __EquipmentRerollLockTitle，ROI 单点维护）",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__EquipmentRerollLockTitle"
                ]
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollMaterialCheck"
        ]
    },
    "EquipmentRerollMaterialCheck": {
        "desc": "进入效果锁定页时顺便读一次材料持有量初始化库存余额（读不到则跳过初始化，不阻断锁定流程）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollMaterialCheckRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockSelectMaterial"
        ]
    },
    "EquipmentRerollLockAbort": {
        "desc": "放弃锁定：先清理待锁状态并关闭效果锁定页，再按实际返回页面继续",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollLockAbortAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "[JumpBack]CommonClosePage",
            "EquipmentRerollLockAbortAfterClose"
        ]
    },
    "EquipmentRerollLockAbortAfterClose": {
        "desc": "关闭锁定页后的页面分流：确认页直接读取费用，详情页重新进入效果变更",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockAbortOnConfirmPage",
            "EquipmentRerollLockAbortOnDetailsPage"
        ],
        "on_error": [
            "EquipmentRerollLockAbortFailed"
        ]
    },
    "EquipmentRerollLockAbortOnConfirmPage": {
        "desc": "放弃锁定后返回效果变更确认页，不再重复锁定，直接读取本轮费用",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__EquipmentRerollChangeEffectTitle"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollPrepareRerollCost"
        ]
    },
    "EquipmentRerollLockAbortOnDetailsPage": {
        "desc": "兼容旧页面层级：放弃锁定后若返回装备详情页，则重新进入效果变更",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    460,
                    380,
                    240,
                    130
                ],
                "template": [
                    "EquipmentReroll/InspectFlag.png"
                ],
                "threshold": 0.9,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollClickChangeEffect"
        ]
    },
    "EquipmentRerollLockAbortFailed": {
        "desc": "关闭锁定页后无法确认所在页面，显式失败并提示用户",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollFailAction",
                "custom_action_param": {
                    "reason": "lock_abort_page_unknown"
                }
            }
        }
    },
    "EquipmentRerollAfterMaterialCheck": {
        "desc": "四件扫描完成（详情页已关闭）后路由（Go）：独立检测→结束；角色→Decide；单件→SingleDecide",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollAfterMaterialCheckAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 100
    },
    "EquipmentRerollLockSelectMaterial": {
        "desc": "选择锁定材料：自订密钥优先，不够用订制模块（Go决策）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollLockSelectRecognition",
                "custom_recognition_param": {}
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollLockSelectRouteAction"
            }
        },
        "rate_limit": 100,
        "next": [
            "__EquipmentRerollRetryGateLockSelectMaterial"
        ]
    },
    "EquipmentRerollLockSelectModule": {
        "desc": "点击左侧订制模块 SELECT",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    500,
                    460,
                    105,
                    36
                ],
                "expected": [
                    "SELECT"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 50,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockConfirm",
            "__EquipmentRerollRetryGateLockSelectModule"
        ]
    },
    "EquipmentRerollLockSelectKey": {
        "desc": "点击右侧自订密钥 SELECT（优先）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    644,
                    460,
                    105,
                    36
                ],
                "expected": [
                    "SELECT"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 50,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockConfirm",
            "__EquipmentRerollRetryGateLockSelectKey"
        ]
    },
    "EquipmentRerollLockConfirm": {
        "desc": "点击锁定页底部“确认”（启用前灰色，SELECT后变蓝）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__EquipmentRerollLockTitle",
