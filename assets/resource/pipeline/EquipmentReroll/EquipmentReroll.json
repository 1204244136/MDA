                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 50,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockComplete",
            "__EquipmentRerollRetryGateLockConfirm"
        ]
