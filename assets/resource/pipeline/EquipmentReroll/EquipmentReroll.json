            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollLockCheckRecognition",
                "custom_recognition_param": {
                    "global_quota": {
                        "优越代码伤害增加": 4
                    }
                }
            }
        },
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockRouteSlot"
        ]
    },
