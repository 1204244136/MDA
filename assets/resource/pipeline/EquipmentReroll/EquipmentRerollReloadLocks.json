{
    "EquipmentRerollReloadLocks": {
        "desc": "复用历史锁方案",
        "recognition": {
            "type": "And", // 三条同时成立才点：完整计划一致 + 确认页标题在场 + 加载按钮亮蓝。库存不足时按钮是灰的；单槽相同不算一致，Go 侧比的是完整锁计划
            "param": {
                "all_of": [
                    "__EquipmentRerollPreviousLockSettings", // 放首位：点击落在「加载先前的锁定设置」文字上
                    "__EquipmentRerollReloadLocksPlan",
                    "__EquipmentRerollChangeEffectTitle",
                    "__EquipmentRerollReloadLocksBlue"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 100,
        "timeout": 3000,
        "next": [
            "EquipmentRerollReloadLocksDone",
            "__EquipmentRerollRetryGateReloadLocksDone"
        ]
    },
    "EquipmentRerollReloadLocksDone": {
        "desc": "核验锁位并同步快照",
        "recognition": {
            "type": "Custom", // 要等实测三槽锁色与计划一致才写快照：加载有过渡帧，中途写会存下错的锁位
            "param": {
                "custom_recognition": "EquipmentRerollReloadLocksVerifyRecognition"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollReloadLocksDoneAction"
            }
        },
        "post_delay": 0,
        "timeout": 3000,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollPrepareRerollCost",
            "__EquipmentRerollRetryGateCostUnreadable"
        ]
    },
    "__EquipmentRerollReloadLocksEnabled": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__EquipmentRerollPreviousLockSettings",
                    "__EquipmentRerollChangeEffectTitle",
                    "__EquipmentRerollReloadLocksBlue"
                ]
            }
        }
    },
    "__EquipmentRerollReloadLocksBlue": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__EquipmentRerollPreviousLockSettings",
                "method": 40,
                "lower": [
                    85,
                    140,
                    150
                ],
                "upper": [
                    115,
                    255,
                    255
                ],
                "count": 80
            }
        }
    },
    "__EquipmentRerollReloadLocksPlan": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EquipmentRerollReloadLocksPlanRecognition"
            }
        }
    },
    "__EquipmentRerollRetryGateReloadLocksDone": {
        "desc": "加载锁重试闸门",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollRetryGateAction", // 按时间窗口计连续命中（默认 5s 内 3 次）判断原地打转，超限才转 Failed。不能用 max_hit：它是任务级累计，反复加载会误伤
                "custom_action_param": {
                    "key": "reload_locks_done",
                    "retry": "EquipmentRerollReloadLocksDone",
                    "give_up": "EquipmentRerollReloadLocksFailed",
                    "next": [
                        "EquipmentRerollReloadLocksDone",
                        "__EquipmentRerollRetryGateReloadLocksDone"
                    ]
                }
            }
        },
        "post_delay": 300, // 留 300ms 给加载反馈，避免拿同一帧连判
        "timeout": 5000,
        "rate_limit": 500
    },
    "EquipmentRerollReloadLocksFailed": {
        "desc": "锁位核验失败中止",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollFailAction", // reason 决定 i18n 文案；失败前清掉待锁与未提交的费用，避免在未知锁状态下继续消耗
                "custom_action_param": {
                    "reason": "reload_locks_verify_failed"
                }
            }
        }
    },
