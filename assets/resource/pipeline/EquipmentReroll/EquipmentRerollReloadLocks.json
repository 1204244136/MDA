    "__EquipmentRerollConfirmSlot1Empty": {
        "desc": "1 号槽空槽确认", // 与确认页词条行同高：三槽行距 27px（236/263/290）
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    236,
                    205,
                    27
                ],
                "expected": "未获得效果" // 空槽不画锁图标，三种锁色必然全不命中；但识别失败不能当成未锁，必须先认出「未获得效果」
            }
