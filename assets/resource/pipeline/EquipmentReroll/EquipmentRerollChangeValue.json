{
    "EquipmentRerollValueScanFailed": {
        "desc": "数值模式扫描重试超时，停止任务并保留当前装备现场",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollFailAction",
                "custom_action_param": {
                    "reason": "value_scan"
                }
            }
        }
    },
    "__EquipmentRerollValueDetailsPage": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    486,
                    400,
                    28,
                    70
                ],
                "method": 40,
                "lower": [
                    [
                        88,
                        120,
                        60
                    ]
                ],
                "upper": [
                    [
                        112,
                        255,
                        255
                    ]
                ],
                "count": 80
            }
        }
    },
    "__EquipmentRerollValueDetailsButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    460,
                    500,
                    360,
                    170
                ],
                "expected": "重新设置数值"
            }
        }
    },
    "EquipmentRerollValueDecide": {
        "desc": "数值重洗决策分发", // 达标直接进摘要；未达标由 ValueDecideAction 打开选定部位详情，回来后经上方锚点进锁定链
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollValueDecideAction"
            }
        },
        "anchor": {
            "EquipmentRerollAfterOpenHead": "EquipmentRerollLockGate", // 四个部位打开详情后统一进共用锁定链：这里把 AfterOpen* 锚点指到 EquipmentRerollLockGate
            "EquipmentRerollAfterOpenArms": "EquipmentRerollLockGate",
            "EquipmentRerollAfterOpenTorso": "EquipmentRerollLockGate",
            "EquipmentRerollAfterOpenLegs": "EquipmentRerollLockGate"
        },
        "next": [
            "EquipmentRerollFinalSummary"
        ]
    },
    "EquipmentRerollValueReturnToDecide": {
        "desc": "回人物页重新调度", // 先 [JumpBack] 关页面回人物页，再回决策节点按已提交快照重算下一步；关不掉时直接重调度
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonClosePage",
            "EquipmentRerollValueDecide"
        ]
    },
    "EquipmentRerollKeepClickSlot1": {
        "desc": "1 号槽锁定入口", // 效果策略只锁 2/3 号槽，1 号槽只在数值策略里用来保护已达标的高值词条；识别框是整条词条行（361×102）：点击框向内收 30/60/4/8，落在行内热区而不是行边缘
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__EquipmentRerollChangeEffectSlot1",
                    "__EquipmentRerollChangeEffectTitle"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    30,
                    4,
                    -60,
                    -8
                ]
            }
        },
        "post_wait_freezes": {
            "time": 150 // 等 150ms 让确认页切到锁定页，避免拿旧帧去判
        },
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "EquipmentRerollLockPageEntered",
            "__EquipmentRerollRetryGateKeepClickSlot1"
        ]
    },
    "__EquipmentRerollChangeEffectSlot1": {
        "recognition": {
            "type": "DirectHit",
            "param": {
                "roi": "__EquipmentRerollChangeEffectTitle",
                "roi_offset": [
                    -128,
                    90,
                    241,
                    2
                ]
            }
        }
    },
    "__EquipmentRerollRetryGateKeepClickSlot1": {
        "desc": "锁定点击重试闸门",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EquipmentRerollRetryGateAction", // 同其它闸门：按 5s 窗口计连续命中，超限转 EquipmentRerollLockAbort 放弃锁定，不在确认页原地连点
                "custom_action_param": {
                    "key": "keep_click_slot1",
                    "retry": "EquipmentRerollKeepClickSlot1",
                    "give_up": "EquipmentRerollLockAbort",
                    "next": [
                        "EquipmentRerollLockPageEntered",
                        "EquipmentRerollKeepClickSlot1",
                        "__EquipmentRerollRetryGateKeepClickSlot1"
                    ]
                }
            }
        },
        "post_delay": 300,
        "timeout": 5000,
        "rate_limit": 500
    }
}
