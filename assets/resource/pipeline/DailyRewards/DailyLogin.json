{
    "DailyRewardsDailyLogin": {
        "desc": "每日登录奖励",
        "max_hit": 1,
        "next": [
            "DailyRewardsDailyLoginEntryFlow",
            "CommonEndTask"
        ]
    },
    "DailyRewardsDailyLoginEntryFlow": {
        "desc": "每日登录奖励入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "DailyLoginClickEntry",
            "[JumpBack]CoordinatedOperationsSlideBanner",
            "CommonEndTask"
        ]
    },
    "DailyLoginClickEntry": {
        "desc": "寻找每日登录奖励图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    9,
                    60,
                    151,
                    52
                ],
                "template": [
                    "Common/RedDot.png" //占位，应该去task页面修改
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 2000,
        "next": [
            "DailyLoginRewardsFlow"
        ]
    },
    "DailyLoginRewardsFlow": {
        "desc": "登录奖励页面处理，供主动进入和登录弹出复用",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyLoginClaimAllButtonVisible"
                ]
            }
        },
        "next": [
            "[JumpBack]DailyLoginClaimRewards",
            "DailyLoginReturnHall",
            "[JumpBack]CommonConfirmReward"
        ]
    },
    "DailyLoginClaimRewards": {
        "desc": "领取每日登录奖励",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyLoginClaimAllButtonVisible",
                    "DailyLoginRewardsAvailable"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "DailyLoginClaimAllButtonVisible": {
        "desc": "登录奖励领取文本可见",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    686,
                    657,
                    139,
                    34
                ],
                "expected": [
                    ".*全部.*"
                ]
            }
        }
    },
    "DailyLoginReturnHall": {
        "desc": "全部领取按钮变灰后点击主页返回大厅",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonClickHomeButton",
                    "DailyLoginClaimAllButtonVisible",
                    "DailyLoginRewardsClaimed"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "DailyLoginRewardsClaimed": {
        "desc": "登录奖励已领完，全部领取文字为灰色",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "DailyLoginClaimAllButtonVisible",
                "lower": [
                    100,
                    100,
                    100
                ],
                "upper": [
                    180,
                    180,
                    180
                ],
                "count": 100
            }
        }
    },
    "DailyLoginRewardsAvailable": {
        "desc": "登录奖励可用",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "DailyLoginClaimAllButtonVisible",
                //多段区间取并集：任一区间达到 count 即命中，避免每期活动换主题时改颜色
                "lower": [
                    [
                        200,
                        200,
                        200
                    ], //白色文字，如 Daily Evil Deed
                    [
                        225,
                        235,
                        60
                    ] //金色文字，如 HeroDays
                ],
                "upper": [
                    [
                        255,
                        255,
                        255
                    ],
                    [
                        245,
                        255,
                        95
                    ]
                ],
                "count": 100
            }
        }
    }
}
