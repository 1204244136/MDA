{
    "DailyRewardsMission": {
        "desc": "任务收取入口",
        "max_hit": 1,
        "next": [
            "DailyRewardsEnterMission",
            "CommonEndTask"
        ]
    },
    "DailyRewardsEnterMission": {
        "desc": "进入任务页面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1116,
                    50,
                    20,
                    20
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -10,
                    10,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 500,
        "next": [
            "DailyRewardsMissionFlow",
            "DailyRewardsEnterMission"
        ]
    },
    "DailyRewardsMissionFlow": {
        "desc": "任务页面领取流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    485,
                    121,
                    53,
                    20
                ],
                "expected": [
                    "每日任务"
                ]
            }
        },
        "next": [
            "[JumpBack]DailyRewardsMissionClickRedDot", // 只有出现红点的页签才需要领，逐个点过去
            "CommonClosePage",
            "CommonEndTask"
        ]
    },
    "DailyRewardsMissionClickRedDot": {
        "desc": "点击任务页签红点",
        "max_hit": 6, // 四个页签各点一次，红点不消失时也不无限重试
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    453,
                    106,
                    375,
                    28
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -10,
                    10,
                    0,
                    0
                ] // 红点贴在页签右上角，往左下偏到页签本体上才会切页签
            }
        },
        "post_wait_freezes": {
            "time": 800,
            "target": [
                0,
                0,
                0,
                0
            ]
        }, // 整屏稳定 800ms 再判按钮，避免切页签后内容还没渲染完
        "next": [
            "DailyRewardsMissionClaimAll",
            "CommonEndTask"
        ]
    },
    "DailyRewardsMissionClaimAll": {
        "desc": "任务奖励领取",
        "max_hit": 6, // 蓝态重试上限，点击不生效时不再无限自环
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    707,
                    630,
                    108,
                    35
                ],
                "lower": [
                    0,
                    150,
                    230
                ], // 可领取时按钮为亮蓝底，实测主色 (0,168,248)
                "upper": [
                    60,
                    210,
                    255
                ],
                "count": 800
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 800,
            "target": [
                0,
                0,
                0,
                0
            ]
        }, // 整屏稳定 800ms 才算动作结束，避开变暗与「正在领取」动画
        "timeout": 30000, // 点完要依次走完变暗、正在领取、奖励弹窗，等 next 的时间给足
        "next": [
            "DailyRewardsMissionConfirmReward",
            "DailyRewardsMissionClaimedVisible",
            "DailyRewardsMissionClaimAll"
        ]
    },
    "DailyRewardsMissionConfirmReward": {
        "desc": "领取奖励弹窗",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonConfirmReward"
                ]
            }
        },
        "pre_wait_freezes": 500, // 与共享节点保持一致，等弹窗滑入动画停稳再点
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 1000,
            "target": [
                0,
                0,
                0,
                0
            ]
        } // 点完领取会先变暗再出「正在领取」，等整屏稳定 1s 才算领完，避免提前跳流程
    },
    "DailyRewardsMissionClaimedVisible": {
        "desc": "全部领取按钮已置灰",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    707,
                    630,
                    108,
                    35
                ],
                "lower": [
                    100,
                    100,
                    100
                ], // 领取完成后按钮转灰底 (120,120,120)，这是本页签领完的信号
                "upper": [
                    180,
                    180,
                    180
                ],
                "count": 800
            }
        }
    }
}
