    "AdviseNikkeMainPageEntered": {
        "desc": "处于妮姬界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "妮姬"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
