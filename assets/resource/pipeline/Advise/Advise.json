{
    "AdviseMain": {
        "desc": "咨询入口",
        "max_hit": 1,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "AdviseEnterAdvisePage",
            "AdviseMainPageEntered",
            "AdviseNikkeMainPageEntered",
            "AdviseEntryFlow",
            "[JumpBack]SceneEnterHall"
        ]
    },
    "AdviseEntryFlow": {
        "desc": "开始咨询总流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "AdviseEnterNikkePage",
            "CommonEndTask"
        ]
    },
    "AdviseEnterNikkePage": {
        "desc": "进入妮姬界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    501,
                    632,
                    28,
                    23
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/New.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -30,
                    30,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 1000,
        "next": [
            "AdviseEnterAdvisePage",
            "AdviseNikkeMainPageEntered",
            "AdviseEnterNikkePage"
        ]
    },
    "AdviseEnterAdvisePage": {
        "desc": "咨询业务入口，保留 NikkeAdvise 选项开关",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "AdviseMainPageEntered",
                    "AdviseNikkeMainPageEntered"
                ]
            }
        },
        "next": [
            "AdviseMainPageFlow",
            "AdviseClickAdvisePage"
        ]
    },
    "AdviseClickAdvisePage": {
        "desc": "从妮姬页面点击咨询入口",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1082,
                    74,
                    58,
                    24
                ],
                "expected": [
                    "咨询"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "AdviseMainPageFlow",
            "AdviseClickAdvisePage"
        ]
    },
    "AdviseMainPageFlow": {
        "desc": "已进入咨询页面后执行业务",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AdviseMainPageEntered"
                ]
            }
        },
        "next": [
            "[JumpBack]AdviseEpisodeViewingEntry",
            "AdviseChooseNikke",
            "AdviseMainPageEntered",
            "AdviseEnterAdvisePage"
        ]
    },
    "AdviseChooseNikke": {
        "desc": "选择Nikke",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    152,
                    238,
                    56,
                    24
                ],
                "expected": [
                    ".*RAN.*"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "AdviseChooseNikke",
            "AdviseFlow"
        ]
    },
    "AdviseMainPageEntered": {
        "desc": "处于咨询界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "咨询"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
