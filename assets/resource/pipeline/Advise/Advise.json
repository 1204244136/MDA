{
    "AdviseMain": {
        "desc": "咨询入口",
        "max_hit": 1,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "AdviseEnterAdvisePage",
            "AdviseMainPageEntered",
            "AdviseNikkeMainPageEntered",
            "AdviseEntryFlow",
            "[JumpBack]SceneEnterHall"
        ]
    },
    "AdviseEntryFlow": {
        "desc": "开始咨询总流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "AdviseEnterNikkePage",
            "CommonEndTask"
        ]
    },
    "AdviseEnterNikkePage": {
        "desc": "进入妮姬界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    501,
                    632,
                    28,
                    23
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/New.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -30,
                    30,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 1000,
        "next": [
            "AdviseEnterAdvisePage",
            "AdviseNikkeMainPageEntered",
            "AdviseEnterNikkePage"
        ]
    },
    "AdviseEnterAdvisePage": {
        "desc": "咨询业务入口",
        "recognition": {
            "type": "Or", // NikkeAdvise 选项开关直接覆盖本节点的 enabled（Yes=true / No=false），改名或删节点会让老配置失配
            "param": {
                "any_of": [
                    "AdviseMainPageEntered",
                    "AdviseNikkeMainPageEntered"
                ]
            }
        },
        "next": [
            "AdviseMainPageFlow",
            "AdviseClickAdvisePage"
        ]
    },
    "AdviseClickAdvisePage": {
        "desc": "从妮姬页面点击咨询入口",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1082,
                    74,
                    58,
                    24
                ],
                "expected": [
                    "咨询"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "AdviseMainPageFlow",
            "AdviseClickAdvisePage"
        ]
    },
    "AdviseMainPageFlow": {
        "desc": "已进入咨询页面后执行业务",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AdviseMainPageEntered"
                ]
            }
        },
        "next": [
            "[JumpBack]AdviseEpisodeViewingEntry",
            "[JumpBack]AdviseOpenFilterPopup",
            "AdviseChooseNikke",
            "AdviseMainPageEntered",
            "AdviseEnterAdvisePage"
        ]
    },
    "AdviseOpenFilterPopup": {
        "desc": "打开筛选菜单",
        "enabled": false,
        "max_hit": 1, // 筛选后按钮文字不变，限流防止 [JumpBack] 回跳死循环
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    724,
                    140,
                    70, // 只框住按钮文字区，避开左侧漏斗图标与右侧排序箭头
                    28
                ],
                "expected": [
                    "追踪妮姬",
                    "全新花絮",
                    "好感度"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]AdviseClickUpgradable",
            "AdviseCloseFilterPopup"
        ]
    },
    "AdviseClickUpgradable": {
        "desc": "筛选可升级",
        "max_hit": 2, // 最多点两次，防止状态未变蓝时在 [JumpBack] 中无限重试
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AdviseUpgradableVisible", // 放首位以取文字框作为点击目标
                    "AdviseUpgradableUnselected"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "AdviseUpgradableVisible": {
        "desc": "可升级选项",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    552,
                    298,
                    78,
                    42
                ],
                "expected": [
                    "可升级"
                ]
            }
        }
    },
    "AdviseUpgradableUnselected": {
        "desc": "可升级未选中",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "AdviseUpgradableVisible",
                "roi_offset": [
                    -11, // 从文字框外扩到深灰按钮背景，蓝色选中态在此区间无命中
                    -6,
                    24,
                    13
                ],
                "lower": [
                    20,
                    20,
                    20
                ],
                "upper": [
                    100,
                    100,
                    100
                ],
                "count": 600 // 仅匹配未选中深灰按钮背景，过滤蓝色选中态
            }
        }
    },
    "AdviseCloseFilterPopup": {
        "desc": "关闭筛选弹窗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    552,
                    178,
                    50,
                    28
                ],
                "expected": [
                    "排序"
                ]
            }
        },
        "next": [
            "CommonClickBlank"
        ]
    },
    "AdviseChooseNikke": {
        "desc": "选择Nikke",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    152,
                    238,
                    56,
                    24
                ],
                "expected": [
                    ".*RAN.*"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "AdviseChooseNikke",
            "AdviseFlow"
        ]
    },
    "AdviseMainPageEntered": {
        "desc": "处于咨询界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    14,
                    17,
                    35, // 只包住标题文字，避开右侧信息图标
                    20
                ],
                "expected": [
                    "咨询"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        }
    },
    "AdviseNikkeMainPageEntered": {
        "desc": "处于妮姬界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    "妮姬"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        }
    }
}
