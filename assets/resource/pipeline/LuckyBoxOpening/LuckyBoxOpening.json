    "LuckyBoxOpeningClickUseAll": {
        "desc": "点击全部使用", //白/蓝两态都可识别；切分类会重置为白态，所以每次点一下就是全选
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1193, // 仅框住「全部使用」四字，避开左侧复选框与右侧提示图标
                    143,
                    44,
                    20
                ],
                "expected": [
                    "全部使用"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [
                1131,
                577,
                122,
                39
            ]
        },
        "next": [
            "LuckyBoxOpeningClickUse",
            "CommonEndTask"
        ]
    },
    "LuckyBoxOpeningClickUse": {
        "desc": "点击使用", //蓝色=可点；灰色=该类没有可用的随机宝箱/捆包，直接结束本类
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1131,
                    577,
                    122,
                    39
