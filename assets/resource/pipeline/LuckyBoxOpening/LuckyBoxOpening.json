{
    "LuckyBoxOpeningMain": {
        "desc": "宝箱开启",
        "max_hit": 1,
        "next": [
            "LuckyBoxOpeningEnterFlow",
            "LuckyBoxOpeningEnterHall",
            "[JumpBack]SceneEnterHall"
        ]
    },
    "LuckyBoxOpeningEnterHall": {
        "desc": "宝箱开启入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "LuckyBoxOpeningClickEntryRedDot",
            "CommonEndTask"
        ]
    },
    "LuckyBoxOpeningClickEntryRedDot": {
        "desc": "点击宝箱开启红点",
