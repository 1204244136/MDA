            "type": "TemplateMatch",
            "param": {
                "roi": [
                    720,
                    635,
                    17,
                    16
                ],
                "template": [
                    "Common/RedDot.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -20,
                    20,
                    0,
                    0
                ]
            }
        },
        "next": [
            "LuckyBoxOpeningEnterFlow",
            "LuckyBoxOpeningClickEntryRedDot" //兜底：点击未生效、仍停在入口页时重新点一次
