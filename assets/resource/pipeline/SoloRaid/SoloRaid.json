{
    "SoloRaidMain": {
        "desc": "单人突击入口",
        "max_hit": 1,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "SoloRaidEntry",
            "[JumpBack]CommonReturnHall"
        ]
    },
    "SoloRaidEntry": {
        "desc": "进入单人突击",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "SoloRaidClickEntry",
            "CommonEndTask"
        ]
    },
    "SoloRaidClickEntry": {
        "desc": "点击单人突击",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    120,
                    360,
                    260
                ],
                "template": [
                    "SoloRaid/SoloRaid.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "SoloRaidFlow",
            "SoloRaidConfirmResult",
            "SoloRaidClickEntry" //兜底
        ]
    },
    "SoloRaidFlow": {
        "desc": "单人突击流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    230,
                    25
                ],
                "expected": [
                    "单人突击"
                ]
            }
        },
        "next": [
            "[JumpBack]CommonConfirmAction",
            "SoloRaidBattleLocked",
            "SoloRaidBattleAttemptsExhausted",
            "[JumpBack]SoloRaidSelectLevel"
        ]
    },
    "SoloRaidBattleLocked": {
        "desc": "单人突击关卡未解锁",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    629,
                    274,
                    22,
                    22
                ],
                "template": [
                    "SoloRaid/SoloRaidBattleLocked.png"
                ]
            }
        }
    },
    "SoloRaidBattleAttemptsExhausted": {
        "desc": "单人突击挑战次数耗尽",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    570,
                    625,
                    140,
                    30
                ],
                "expected": [
                    ".*0/3.*"
                ]
            }
        }
    },
    "SoloRaidConfirmResult": {
        "desc": "单人突击确认结果",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    519,
                    483,
                    115,
                    38
                ],
                "expected": [
                    "奖励内容"
                ]
            }
        }
    },
    "SoloRaidSelectLevel": {
        "desc": "单人突击选择关卡",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SoloRaidSelectLevelVisible",
                    "SoloRaidSelectLevelAvailable"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]CommonConfirmAction",
            "BattleEntryFlow"
        ]
    },
    "SoloRaidSelectLevelVisible": {
        "desc": "单人突击关卡可见",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    455,
                    58,
                    326,
                    42
                ],
                "template": [
                    "SoloRaid/SoloRaidLevelⅠ.png",
                    "SoloRaid/SoloRaidLevelⅡ.png",
                    "SoloRaid/SoloRaidLevelⅢ.png",
                    "SoloRaid/SoloRaidLevelⅣ.png",
                    "SoloRaid/SoloRaidLevelⅤ.png",
                    "SoloRaid/SoloRaidLevelⅥ.png",
                    "SoloRaid/SoloRaidLevelⅦ.png"
                ]
            }
        }
    },
    "SoloRaidSelectLevelAvailable": {
        "desc": "单人突击关卡已开放",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "SoloRaidSelectLevelVisible",
                "lower": [
                    150,
                    100,
                    0
                ],
                "upper": [
                    255,
                    210,
                    90
                ],
                "count": 10,
                "order_by": "Horizontal",
                "index": -1 //选择最右侧的已开放关卡
            }
        }
    }
}
