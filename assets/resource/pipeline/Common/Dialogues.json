{
    "DialoguesSkipStory": {
        "desc": "跳过剧情",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1218,
                    9,
                    39,
                    16
                ],
                "expected": [
                    "(?i).*?ski?p?.*?" //SKIP
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000
    },
    "DialoguesClickContinue": {
        "desc": "点击继续",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    622,
                    646,
                    336,
                    70
                ],
                "template": [
                    "Dialogues/Continue.png"
                ],
                "threshold": 0.85 // 提高阈值过滤立绘衣褶对极小三角模板的误命中
            }
        },
        "action": {
            "type": "Click"
        },
        "repeat": 5,
        "repeat_delay": 200
    },
    "DialoguesClickOption": {
        "desc": "点击选项",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    452,
                    383,
                    56,
                    324
                ],
                "template": [
                    "Dialogues/Option1.png" // 模板匹配选项 1 徽章，解决亮背景单选项 OCR 漏检
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    50,
                    0,
                    0,
                    0
                ]
            }
        }
    },
    "DialoguesMainVisible": {
        "desc": "剧情的标识",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    953,
                    0,
                    327,
                    75
                ],
                "expected": [
                    ".*HIDE.*",
                    ".*AUTO.*",
                    ".*LOG.*",
                    "(?i).*?ski?p?.*?" //SKIP
                ]
            }
        }
    },
    "DialoguesMainHidden": {
        "desc": "剧情界面已退出",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DialoguesMainVisible"
                ]
            }
        },
        "inverse": true
    }
}
