{
    "ArenaMain": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "[JumpBack]ArenaClaimSpecialReward",
            "ArenaCornerFlow",
            "[JumpBack]ArenaPrepareEntry",
            "[JumpBack]SceneEnterArena"
        ]
    },
    "ArenaPrepareEntry": {
        "desc": "入场前先回方舟", // 直接场景导航进竞技场会漏掉累积奖励，所以先回方舟再回 Main 领奖
        "max_hit": 1,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonArkEntered",
                    "ArenaMainPageEntered"
                ]
            }
        },
        "inverse": true, // 已在方舟或竞技场首页时不走这条，避免无谓绕路
        "next": [
            "SceneEnterArk"
        ]
    },
    "ArenaClaimSpecialReward": {
        "desc": "领取累积奖励",
        "max_hit": 1, // 每次任务只打开一次；官方领奖状态未刷新时重复进入只会白跑一趟
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    785,
                    318,
                    26,
                    25
                ],
                "expected": [
                    "^[0-9]{1,3}[%％]$" //只认累积奖励百分比；只写 ^[0-9] 会在竞技场首页命中「剩余…小时」倒计时并误点进子页
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]CommonConfirmReward",
            "[JumpBack]ArenaConfirmSpecialReward",
            "CommonClosePage",
            "CommonEndTask"
        ]
    },
    "ArenaConfirmSpecialReward": {
        "desc": "领奖确认按钮",
        "max_hit": 1, // 最多点一次；没有奖励时确认按钮不出现，本节点不命中，由 ArenaClaimSpecialReward 的 next 继续走关闭流程
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonConfirmAction"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "ArkEnterArena": {
        "desc": "进入竞技场",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    710,
                    461,
                    85,
                    21
                ],
                "expected": [
                    "竞技场"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "next": [
            "ArenaCornerFlow",
            "ArkEnterArena"
        ]
    },
    "ArenaMainPageEntered": {
        "desc": "处于竞技场",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "RookieArenaVisible",
                    "SpecialArenaVisible",
                    "ChampionArenaVisible"
                ]
            }
        }
    },
    "ArenaCornerFlow": {
        "desc": "竞技场流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaMainPageEntered"
                ]
            }
        },
        "next": [
            "ArenaEnterRookieArena",
            "ArenaEnterSpecialArena",
            "ArenaEnterChampionArena",
            "CommonEndTask"
        ]
    },
    "ArenaClickFreeBattle": {
        "desc": "点击免费战斗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    749,
                    579,
                    54,
                    26
                ],
                "expected": [
                    "免费"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500, //再低会出现双击从而跳过流程
        "next": [
            "ArenaFreeBattleFlow",
            "ArenaClickFreeBattle"
        ]
    },
    "ArenaFreeBattleVisible": {
        "desc": "免费战斗页面可见",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    526,
                    566,
                    59,
                    22
                ],
                "expected": [
                    ".*快速.*" //快速战斗
                ]
            }
        }
    },
    "ArenaFreeBattleFlow": {
        "desc": "免费战斗流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaFreeBattleVisible"
                ]
            }
        },
        "timeout": 60000,
        "next": [
            "BattleEntered",
            "[JumpBack]CommonPurchaseGemBlocked",
            "[JumpBack]RookieArenaClickQuickBattleToggle",
            "[JumpBack]ArenaConfirmFreeBattle"
        ]
    },
    "ArenaConfirmFreeBattle": {
        "desc": "确认发起免费战斗", //只在出击确认面板内点“进入战斗”；面板一关就收手，绝不回头点对手列表里的付费挑战
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleMainVisible", // 放首位：命中框就是「进入战斗」按钮，点击不会落到面板外同区域的对手列表行
                    "ArenaFreeBattleVisible",
                    "BattleAvailable"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    }
}
