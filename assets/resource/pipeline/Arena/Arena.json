{
    "ArenaMain": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RuntimeQuotaCheck"
            }
        },
        "next": [
            "[JumpBack]ArenaClaimSpecialReward",
            "ArkEnterArena",
            "[JumpBack]CommonEnterArk"
        ]
    },
    "ArenaClaimSpecialReward": {
        "desc": "领取累积奖励",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    785,
                    318,
                    26,
                    25
                ],
                "expected": [
                    "^[0-9]"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]CommonConfirmAction",
            "[JumpBack]CommonConfirmReward",
            "ArenaClaimSpecialReward",
            "CommonEndTask"
        ]
    },
    "ArkEnterArena": {
        "desc": "进入竞技场",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    710,
                    461,
                    85,
                    21
                ],
                "expected": [
                    "竞技场"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "next": [
            "ArenaCornerFlow",
            "ArkEnterArena"
        ]
    },
    "ArenaMainPageEntered": {
        "desc": "处于竞技场",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "RookieArenaVisible",
                    "SpecialArenaVisible",
                    "ChampionArenaVisible"
                ]
            }
        }
    },
    "ArenaCornerFlow": {
        "desc": "竞技场流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaMainPageEntered"
                ]
            }
        },
        "next": [
            "ArenaEnterRookieArena",
            "ArenaEnterSpecialArena",
            "ArenaEnterChampionArena",
            "CommonEndTask"
        ]
    },
    "ArenaClickFreeBattle": {
        "desc": "点击免费战斗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    749,
                    579,
                    54,
                    26
                ],
                "expected": [
                    "免费"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500, //再低会出现双击从而跳过流程
        "next": [
            "ArenaFreeBattleFlow",
            "ArenaClickFreeBattle"
        ]
    },
    "ArenaFreeBattleVisible": {
        "desc": "免费战斗页面可见",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    526,
                    566,
                    59,
                    22
                ],
                "expected": [
                    "快速战斗"
                ]
            }
        }
    },
    "ArenaFreeBattleFlow": {
        "desc": "免费战斗流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaFreeBattleVisible"
                ]
            }
        },
        "timeout": 60000,
        "next": [
            "BattleEntered",
            "[JumpBack]CommonPurchaseGemBlocked",
            "[JumpBack]RookieArenaClickQuickBattleToggle",
            "[JumpBack]ArenaConfirmFreeBattle"
        ]
    },
    "ArenaConfirmFreeBattle": {
        "desc": "确认发起免费战斗", //只在出击确认面板内点“进入战斗”；面板一关就收手，绝不回头点对手列表里的付费挑战
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaFreeBattleVisible",
                    "BattleMainVisible",
                    "BattleAvailable"
                ],
                "box_index": 1 //取“进入战斗”的识别框，避免点到面板外同区域内的对手列表行
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    }
}
