{
    "CustomBurstConfig": {
        "desc": "自定义爆裂配置承载节点：选项通过 pipeline_override 写 attach 顶层键（按 key 浅合并）。r{轮}s{阶段}=角色（空=不指定）；round_count=使用轮数（默认1）",
        "attach": {
            "round_count": 1,
            "r1s1": "",
            "r1s2": "",
            "r1s3": "",
            "r2s1": "",
            "r2s2": "",
            "r2s3": "",
            "r3s1": "",
            "r3s2": "",
            "r3s3": "",
            "r4s1": "",
            "r4s2": "",
            "r4s3": "",
            "r5s1": "",
            "r5s2": "",
            "r5s3": "",
            "r6s1": "",
            "r6s2": "",
            "r6s3": ""
        }
    },
    "FastBurstStage": {
        "desc": "爆裂阶段汇总：一次识别返回Ⅰ/Ⅱ/Ⅲ颜色子节点结果",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "FastBurstHexGreen",
                    "FastBurstHexOrange",
                    "FastBurstHexRed"
                ]
            }
        }
    },
    "FastBurstChargeBar": {
        "desc": "爆裂充能条：右上角 BURST 横条的中性灰充能段（不使用绿色/红色阶段长条）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1192,
                    293,
                    80,
                    5
                ],
                "method": 4,
                "lower": [
                    155,
                    155,
                    155
                ],
                "upper": [
                    185,
                    185,
                    185
                ],
                "count": 100
            }
        }
    },
