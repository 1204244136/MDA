    "CustomBurstMain": {
        "desc": "自定义爆裂入口：等待进入战斗画面（参考项目原有战斗识别节点 BattleCombatHudVisible）；不出现则正常超时",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "BattleCombatHudVisible"
                ]
            }
        },
        "next": [
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstWaitCharge": {
        "desc": "低频等待爆裂进入可检测状态：灰色充能条命中=已开始充能，进入高频检测（不是“可按键”）；阶段色(Ⅰ/Ⅱ/Ⅲ)出现=已就绪，同样进入高频。二者任一命中即切入 CustomBurstLoop",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "FastBurstChargeBar",
                    "FastBurstStage"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "next": [
            "CustomBurstLoop",
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstLoop": {
        "desc": "循环：高频检测并释放；每1s经安全门检查暂停/结算，避免OCR占用爆裂转换窗口",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FastBurstPanelRecognition"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CustomBurstRouteAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstReturnToLowFrequency",
            "CustomBurstSafetyGate",
            "CustomBurstLoop"
        ]
    },
    "CustomBurstReturnToLowFrequency": {
        "desc": "一轮爆裂结束状态门：仅在面板消失后命中一次，返回低频充能条检测",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CustomBurstReturnToLowFrequencyRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstWaitCharge",
            "CustomBurstWaitSafetyGate"
        ]
    },
    "CustomBurstWaitSafetyGate": {
        "desc": "等待充能期间低频暂停/结算检查门：每1s放行一次，未到间隔立即回到等待；命中暂停/结算则结束任务",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CustomBurstSafetyGateRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstCheckPause",
            "CustomBurstCheckSettle",
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstSafetyGate": {
        "desc": "暂停/结算低频检测门：仅每1s放行一次，未到间隔时立即回到高频爆裂循环",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CustomBurstSafetyGateRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstCheckPause",
            "CustomBurstCheckSettle",
            "CustomBurstLoop"
        ]
    },
    "CustomBurstCheckPause": {
        "desc": "检测用户是否暂停（暂停菜单标题「暂停」OCR）；命中则停止任务并输出提示",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    610,
                    38,
                    180,
                    42
                ],
                "expected": [
                    "暂停"
                ]
            }
        },
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CustomBurst.paused"
        }
    },
    "CustomBurstCheckSettle": {
        "desc": "检测战斗结算；命中则停止任务并输出提示",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "BattleSettlementEscVisible",
                    "BattleFailedVisible"
                ]
            }
        },
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CustomBurst.settled"
        }
    }
}
