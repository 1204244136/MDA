    "FastBurstClickKeyA": {
        "desc": "A键释放1号槽位",
        "pre_delay": 0, // 内置 ClickKey 单次点按，前后延时都置 0：是否再按一次由 CustomBurstLoop 的动作侧判断，这里加延时只会错过爆裂窗口
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 65
            }
        },
        "post_delay": 0
    },
    "FastBurstClickKeyS": {
        "desc": "S键释放2号槽位",
        "pre_delay": 0, // 点按策略同 FastBurstClickKeyA
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 83
            }
        },
        "post_delay": 0
    },
    "FastBurstClickKeyD": {
        "desc": "D键释放3号槽位",
        "pre_delay": 0, // 点按策略同 FastBurstClickKeyA
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 68
            }
        },
        "post_delay": 0
    },
    "CustomBurstMain": {
        "desc": "等战斗画面就绪",
        "recognition": {
            "type": "Or", // 复用项目原有战斗识别 BattleCombatHudVisible，不另维护一套战斗画面判据；迟迟不出现就按普通超时结束，不在这里重试
            "param": {
                "any_of": [
                    "BattleCombatHudVisible"
                ]
            }
        },
        "next": [
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstWaitCharge": {
        "desc": "低频等待爆裂开始",
        "recognition": {
            "type": "Or", // 命中任一即切高频：灰色充能条=已开始充能（不是“可按键”）；阶段色Ⅰ/Ⅱ/Ⅲ=已就绪
            "param": {
                "any_of": [
                    "FastBurstChargeBar",
                    "FastBurstStage"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300, // 充能空窗里 300ms 一探足够，不必和后面的高频循环同频
        "next": [
            "CustomBurstLoop",
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstLoop": {
        "desc": "高频检测并释放", // next 顺序即优先级：面板消失（一轮结束）→ 安全门（每 1s 放行一次暂停/结算检查）→ 自环继续高频。安全门排在自环前面，避免 OCR 挤占爆裂阶段切换的窗口
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FastBurstPanelRecognition"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CustomBurstRouteAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0, // 发键时机由动作侧判断，这里不做限速
        "next": [
            "CustomBurstReturnToLowFrequency",
            "CustomBurstSafetyGate",
            "CustomBurstLoop"
        ]
    },
    "CustomBurstReturnToLowFrequency": {
        "desc": "一轮结束的回退门", // 先回低频充能等待；充能条还没出现时才落到等待期安全门
        "recognition": {
            "type": "Custom", // 面板消失后由动作侧置位一次、本节点消费即失效，所以高频循环不会反复回退到低频
            "param": {
                "custom_recognition": "CustomBurstReturnToLowFrequencyRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstWaitCharge",
            "CustomBurstWaitSafetyGate"
        ]
    },
    "CustomBurstWaitSafetyGate": {
        "desc": "等待期暂停结算检查门",
        "recognition": {
            "type": "Custom", // 与 CustomBurstSafetyGate 是同一个 1s 节流识别，区别在未到间隔时回低频等待而不是回高频循环——充能空窗里别把爆裂循环拉起来
            "param": {
                "custom_recognition": "CustomBurstSafetyGateRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstCheckPause",
            "CustomBurstCheckSettle",
            "CustomBurstWaitCharge"
        ]
    },
    "CustomBurstSafetyGate": {
        "desc": "循环中的暂停结算检查门",
        "recognition": {
            "type": "Custom", // custom_recognition 只做 1s 节流（safetyProbeInterval），真正的暂停/结算判断在下游 OCR 节点；未到间隔直接回 CustomBurstLoop
            "param": {
                "custom_recognition": "CustomBurstSafetyGateRecognition"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CustomBurstCheckPause",
            "CustomBurstCheckSettle",
            "CustomBurstLoop"
        ]
    },
    "CustomBurstCheckPause": {
        "desc": "用户暂停检测",
        "recognition": {
            "type": "OCR", // 暂停菜单标题区域认「暂停」；命中后 next 为空即结束任务，focus 把 focus.CustomBurst.paused 交给客户端提示
            "param": {
                "roi": [
                    610,
                    38,
                    180,
                    42
                ],
                "expected": [
                    "暂停"
                ]
            }
        },
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CustomBurst.paused"
        }
    },
    "CustomBurstCheckSettle": {
        "desc": "战斗结束判定",
        "recognition": {
            "type": "Or", // 与主战斗流程同一套判据，命中即结束任务并 focus 输出 settled 提示
            "param": {
                "any_of": [
                    "BattleSettlementContinueVisible",
                    "BattleFailedVisible"
                ]
            }
        },
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CustomBurst.settled"
        }
    }
}
