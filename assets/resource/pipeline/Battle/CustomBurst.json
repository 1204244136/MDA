{
    "CustomBurstConfig": {
        "desc": "爆裂选项承载",
        "attach": {
            "round_count": 1, // 选项统一写本节点 attach：pipeline_override 按 key 浅合并，分散声明会互相覆盖。r{轮}s{阶段}=该阶段释放的角色（A/S/D，空=不指定，整轮空走高频 ASD）；取值 1..6
            "r1s1": "",
            "r1s2": "",
            "r1s3": "",
            "r2s1": "",
            "r2s2": "",
            "r2s3": "",
            "r3s1": "",
            "r3s2": "",
            "r3s3": "",
            "r4s1": "",
            "r4s2": "",
            "r4s3": "",
            "r5s1": "",
            "r5s2": "",
            "r5s3": "",
            "r6s1": "",
            "r6s2": "",
            "r6s3": ""
        }
    },
    "FastBurstStage": {
        "desc": "爆裂阶段三色汇总",
        "recognition": {
            "type": "Or", // 三色共用一个 Or，同帧同轮往返；合并结果没有子 Hit 标志，消费方按子框非空判命中
            "param": {
                "any_of": [
                    "FastBurstHexGreen",
                    "FastBurstHexOrange",
                    "FastBurstHexRed"
                ]
            }
        }
    },
    "FastBurstChargeBar": {
        "desc": "爆裂充能中",
        "recognition": {
            "type": "ColorMatch", // 只取 BURST 横条的中性灰充能段：绿/红阶段长条会随阶段变色，拿它当“已开始充能”的判据会跟着阶段误判
            "param": {
                "roi": [
                    1192,
                    293,
                    80,
                    5
                ],
                "method": 4,
                "lower": [
                    155,
                    155,
                    155
                ],
                "upper": [
                    185,
                    185,
                    185
                ],
                "count": 100
            }
        }
    },
    "FastBurstAnySlot": {
        "desc": "爆裂面板存在性汇总：任一槽位头像可见",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "FastBurstSlot1",
                    "FastBurstSlot2",
                    "FastBurstSlot3"
                ]
            }
        }
    },
