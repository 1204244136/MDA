    "FastBurstClickKeyA": {
        "desc": "使用 MaaFramework 内置点按时长释放 A 键对应槽位角色",
        "pre_delay": 0,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 65
            }
        },
        "post_delay": 0
