{
    "LargeEventEnterMission": {
        "desc": "大活动任务",
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1250,
                    112,
                    30,
                    107
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/RedDotSP.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -10,
                    10,
                    0,
                    0
                ]
            }
        },
        "timeout": 60000,
        "next": [
            "LargeEventMissionFlow"
        ]
    },
    "LargeEventMissionFlow": {
        "desc": "大活动任务流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LargeEventMissionClaimAllButtonVisible"
                ]
            }
        },
        "next": [
            "LargeEventMissionClaimedFlow",
            "[JumpBack]LargeEventMissionClaimAll",
            "[JumpBack]CommonConfirmReward",
            "[JumpBack]CommonConfirmAction",
            "[JumpBack]CommonClosePage",
            "CommonEndTask"
        ]
    },
    "LargeEventMissionClaimAllButtonVisible": {
        "desc": "全部领取按钮可见",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    680,
                    624,
                    137,
                    35
                ],
                "expected": [
                    ".*全部.*"
                ]
            }
        }
    },
    "LargeEventMissionAvailable": {
        "desc": "全部领取按钮可用",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "LargeEventMissionClaimAllButtonVisible",
                "lower": [
                    200,
                    200,
                    200
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 100
            }
        }
    },
    "LargeEventMissionClaimed": {
        "desc": "全部领取按钮已领取",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "LargeEventMissionClaimAllButtonVisible",
                "lower": [
                    190,
                    190,
                    190
                ],
                "upper": [
                    219,
                    219,
                    219
                ],
                "count": 100
            }
        }
    },
    "LargeEventMissionClaimAll": {
        "desc": "点击全部领取",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LargeEventMissionClaimAllButtonVisible",
                    "LargeEventMissionAvailable"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "LargeEventMissionClaimedFlow": {
        "desc": "大活动任务本页签已领完",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LargeEventMissionClaimAllButtonVisible",
                    "LargeEventMissionClaimed"
                ]
            }
        },
        "next": [
            "[JumpBack]LargeEventMissionEnterDaily",
            "[JumpBack]LargeEventMissionEnterAchievement",
            "[JumpBack]CommonClosePage",
            "CommonEndTask"
        ]
    },
    "LargeEventMissionEnterDaily": {
        "desc": "切到每日任务页签",
        "max_hit": 1, //只切一次，避免在两个页签之间来回跳
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    455,
                    112,
                    200,
                    50
                ],
                "expected": [
                    "每日任务"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 800,
        "next": [
            "LargeEventMissionFlow"
        ]
    },
    "LargeEventMissionEnterAchievement": {
        "desc": "切到成就页签",
        "max_hit": 1, //只切一次，避免在两个页签之间来回跳
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    655,
                    112,
                    175,
                    52
                ],
                "expected": [
                    "成就"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 800,
        "next": [
            "LargeEventMissionFlow"
        ]
    }
}
