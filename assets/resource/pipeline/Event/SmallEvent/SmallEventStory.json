{
    "SmallEventEnterStory": {
        "desc": "小活动剧情",
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    314,
                    413,
                    661,
                    294
                ],
                "expected": [
                    ".*加成.*"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    -50,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 500,
        "timeout": 60000,
        "next": [
            "SmallEventEventStagePageFlow"
        ]
    },
    "SmallEventEventStagePageEntered": {
        "desc": "已进入小活动活动关卡页面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    5,
                    18,
                    50,
                    16
                ],
                "expected": [
                    ".*活动关.*"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        }
    },
    "SmallEventEventStagePageFlow": {
        "desc": "小活动活动关卡页面流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SmallEventEventStagePageEntered"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                494,
                505,
                294,
                131
            ]
        },
        "next": [
            "[JumpBack]SmallEventUnlockStage",
            "SmallEventEventStageBattleFlow"
        ]
    },
    "SmallEventUnlockStage": {
        "desc": "小活动关卡解锁",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    601,
                    441,
                    74,
                    28
                ],
                "expected": [
                    ".*点击继续.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "SmallEventEventStageBattleFlow": {
        "desc": "小活动活动关卡页面战斗流程",
        "next": [
            "SmallEventClickStage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventEventStageQuickBattleFlow": {
        "desc": "小活动活动关卡页面快速战斗流程",
        "next": [
            "SmallEventClickStageRepeatable",
            "SmallEventGoBack"
        ]
    },
    "SmallEventEventStageBattlePage": {
        "desc": "小活动活动关卡页面战斗页面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleMainVisible"
                ]
            }
        },
        "next": [
            "SmallEventBattleBlocked",
            "[JumpBack]BattleEntryFlow",
            "SmallEventEventStageAfterBattleFlow",
            "[JumpBack]DialoguesSkipStory"
        ]
    },
    "SmallEventEventStageAfterBattleFlow": {
        "desc": "小活动活动关卡战斗后补体力流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SmallEventEventStagePageEntered"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                494,
                505,
                294,
                131
            ]
        },
        "next": [
            "[JumpBack]SmallEventUnlockStage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventClickStage": {
        "desc": "小活动关卡点击",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    314,
                    103,
                    661,
                    604
                ],
                "template": [
                    "SmallEvent/LittleWitchTrick/LittleWitchTrickStageNormal.png", //当前活动，随最新主题更新
                    "SmallEvent/LittleWitchTrick/LittleWitchTrickStageHard.png"
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "SmallEventEventStageBattlePage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventClickStageRepeatable": {
        "desc": "小活动关卡可扫荡点击",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    314,
                    103,
                    661,
                    604
                ],
                "template": [
                    "SmallEvent/LittleWitchTrick/LittleWitchTrickStageNormalRepeatable.png", //当前活动，随最新主题更新
                    "SmallEvent/LittleWitchTrick/LittleWitchTrickStageHardRepeatable.png"
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        // 当前活动（LittleWitchTrick）的扫荡标识是挂在关卡行右下角外侧的木牌，识别框中心落在关卡行
        // 命中区之外，直接用中心点会点空导致漏打；向左上偏移把落点拉回关卡行上。
        // 该偏移属于「当前活动」专属参数：往期主题 case 必须显式写 target_offset 归零，
        // 否则会静默继承本值（由 npm run check:theme 断言 D 强制校验）。
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -80,
                    -30,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 500,
        "next": [
            "SmallEventEventStageBattlePage",
            "SmallEventGoBack"
        ]
    },
    "SmallEventBattleBlocked": {
        "desc": "活动体力耗尽",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleCannotBattleBlocked"
                ]
            }
        },
        "next": [
            "[JumpBack]BattleClosePage",
            "SmallEventGoBack"
        ]
    }
}
