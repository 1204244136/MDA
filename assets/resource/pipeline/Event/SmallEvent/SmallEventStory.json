{
    "SmallEventEnterStory": {
        "desc": "小活动剧情",
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    314,
                    413,
                    661,
                    294
                ],
                "expected": [
                    ".*加成.*"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    10,
                    -46,
                    -20,
                    -8
                ] // 保留相对文字的固定上移并向中心收束点击区域
            }
        },
        "post_wait_freezes": 500,
        "timeout": 60000,
        "next": [
            "SmallEventEventStagePageFlow"
        ]
    },
    "SmallEventEventStagePageEntered": {
        "desc": "已进入小活动活动关卡页面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    5,
                    18,
                    50,
                    16
                ],
                "expected": [
                    ".*活动关.*"
                ],
                "only_rec": true //避免 batch OCR 降采样后 det 读不出小字
            }
        }
    },
    "SmallEventEventStagePageFlow": {
        "desc": "小活动活动关卡页面流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SmallEventEventStagePageEntered"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                494,
                505,
                294,
                131
            ]
        },
        "next": [
            "[JumpBack]SmallEventUnlockStage",
            "SmallEventEventStageBattleFlow"
        ]
    },
    "SmallEventUnlockStage": {
        "desc": "小活动关卡解锁",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    601,
                    441,
                    74,
                    28
                ],
                "expected": [
                    ".*点击继续.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500
    },
    "SmallEventEventStageBattleFlow": {
        "desc": "小活动活动关卡页面战斗流程",
        "next": [
            "SmallEventClickStage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventEventStageQuickBattleFlow": {
        "desc": "小活动活动关卡页面快速战斗流程", // 当前活动扫荡路由：常规主题走共用节点，仅需专属偏移或拆分的特例主题指向 Themes/
        "next": [
            "SmallEventClickStageRepeatable",
            "SmallEventGoBack"
        ]
    },
    "SmallEventEventStageBattlePage": {
        "desc": "小活动活动关卡页面战斗页面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleMainVisible"
                ]
            }
        },
        "next": [
            "SmallEventBattleBlocked",
            "[JumpBack]BattleEntryFlow",
            "SmallEventEventStageAfterBattleFlow",
            "[JumpBack]DialoguesSkipStory"
        ]
    },
    "SmallEventEventStageAfterBattleFlow": {
        "desc": "小活动活动关卡战斗后补体力流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SmallEventEventStagePageEntered"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                494,
                505,
                294,
                131
            ]
        },
        "next": [
            "[JumpBack]SmallEventUnlockStage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventClickStage": {
        "desc": "小活动关卡点击",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    314,
                    103,
                    661,
                    604
                ],
                "template": [
                    "SmallEvent/SkyOnTheRock/SkyOnTheRockStageNormal.png" //当前活动，随最新主题更新
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "SmallEventEventStageBattlePage",
            "SmallEventEventStageQuickBattleFlow"
        ]
    },
    "SmallEventClickStageRepeatable": {
        "desc": "小活动扫荡关卡点击", // 共用扫荡节点禁止配置 target_offset；需要专属偏移或拆分的主题放到 Themes/
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    314,
                    103,
                    661,
                    604
                ],
                "template": [
                    "SmallEvent/SkyOnTheRock/SkyOnTheRockStageNormalRepeatable.png" //当前活动，随最新主题更新
                ],
                "order_by": "Vertical",
                "index": -1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "next": [
            "SmallEventEventStageBattlePage",
            "SmallEventGoBack"
        ]
    },
    "SmallEventBattleBlocked": {
        "desc": "活动体力耗尽",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BattleCannotBattleBlocked"
                ]
            }
        },
        "next": [
            "[JumpBack]BattleClosePage",
            "SmallEventGoBack"
        ]
    }
}
