{
    "BodyLabelShop": {
        "desc": "躯体标签商店",
        "max_hit": 1,
        "next": [
            "[JumpBack]ShopEnterBodyLabelShop",
            "[JumpBack]ShopPurchaseFlow",
            "[JumpBack]BodyLabelShopPurchaseDiscountedItem",
            "CommonEndTask"
        ]
    },
    "ShopEnterBodyLabelShop": {
        "desc": "进入躯体标签商店",
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    255,
                    55,
                    390
                ],
                "template": [
                    "Shop/BodyLabelShop/BodyLabelShopNotSelected.png",
                    "Shop/BodyLabelShop/BodyLabelShopSelected.png"
                ],
                "threshold": 0.999 // 六个页签图形高度相似，默认阈值会互相误命中：实测自身 1.000、其他页签最高 0.999939，取 0.999 放过自己挡住其他页签（误点无害，下轮会点回本页签）
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "ShopBodyLabelShopEntered",
            "ShopEnterBodyLabelShop"
        ]
    },
    "ShopBodyLabelShopEntered": {
        "desc": "处于躯体标签商店",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    68,
                    264,
                    119,
                    20
                ],
                "expected": [
                    "躯体标签商店"
                ]
            }
        }
    },
    "BodyLabelShopPurchaseDiscountedItem": {
        "desc": "购买打折商品",
        "enabled": false,
        "max_hit": 1, // 一轮只买 1 份
        "recognition": {
            "type": "OCR", // 商品无限量供应，只有 1 号位是「限量 + 打折」且每天轮换，所以只认卡片上的打折标识（黄底白字）；整块商品区 ROI 过滤后只剩标识一框，target_offset 把点击抬到卡片中部
            "param": {
                "roi": [
                    58,
                    338,
                    1222,
                    325
                ],
                "expected": [
                    ".*SALE.*"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    -30,
                    0,
                    0
                ]
            }
        }
    }
}
