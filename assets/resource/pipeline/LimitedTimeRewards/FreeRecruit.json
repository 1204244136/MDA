{
    "LimitedTimeRewardsFreeRecruitMain": {
        "desc": "免费招募入口",
        "max_hit": 1,
        "next": [
            "LimitedTimeRewardsFreeRecruitEntry",
            "[JumpBack]SceneEnterHall"
        ]
    },
    "LimitedTimeRewardsFreeRecruitEntry": {
        "desc": "在大厅寻找免费招募入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "next": [
            "LimitedTimeRewardsEnterFreeRecruit",
            "CommonEndTask"
        ]
    },
    "LimitedTimeRewardsEnterFreeRecruit": {
        "desc": "免费招募",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LimitedTimeRewardsFreeRecruitVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000,
        "next": [
            "[JumpBack]LimitedTimeRewardsFreeRecruitFlow",
            "SceneEnterHall"
        ]
    },
    "LimitedTimeRewardsFreeRecruitAvailable": {
        "desc": "可以免费招募",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LimitedTimeRewardsFreeRecruitVisible"
                ]
            }
        }
    },
    "LimitedTimeRewardsFreeRecruitFlow": {
        "desc": "处理免费招募可用",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "LimitedTimeRewardsFreeRecruitAvailable"
                ]
            }
        },
        "next": [
            "LimitedTimeRewardsClickFreeRecruit",
            "LimitedTimeRewardsFreeRecruitClickNextRecruit",
            "LimitedTimeRewardsFreeRecruitFlow" //兜底
        ]
    },
    "LimitedTimeRewardsClickFreeRecruit": {
        "desc": "点击免费招募",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    480,
                    593,
                    43,
                    14
                ],
                "expected": [
                    ".*免费.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]CommonSkipPlot",
            "LimitedTimeRewardsConfirmRecruit",
            "[JumpBack]CommonClickBlank"
        ]
    },
    "LimitedTimeRewardsConfirmRecruit": {
        "desc": "招募确认", // 大活动签到的领奖确认弹窗同样命中该按钮，改名时同步 LargeEventLoginStamp
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    485,
                    633,
                    228,
                    34
                ],
                "expected": [
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000
    },
    "LimitedTimeRewardsFreeRecruitVisible": {
        "desc": "免费招募的标识",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    750,
                    665,
                    64,
                    22
                ],
                "template": [
                    "LimitedTimeRewards/FreeRecruit/FreeRecruit.png"
                ]
            }
        }
    },
    "LimitedTimeRewardsFreeRecruitClickNextRecruit": {
        "desc": "下一个招募",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1232,
                    349,
                    46,
                    54
                ],
                "template": [
                    "LimitedTimeRewards/FreeRecruit/NextRecruit.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000
    }
}
