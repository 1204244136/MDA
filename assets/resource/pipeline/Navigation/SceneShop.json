{
    "SceneEnterShop": {
        "desc": "纯导航到百货商店，不执行购买",
        "timeout": 10000,
        "next": [
            "ShopMainPageEntered",
            "__ScenePrivateClickShop",
            "[JumpBack]__ScenePrivateRecoverHallForShop"
        ]
    },
    "__ScenePrivateClickShop": {
        "desc": "从大厅点击商店，复用既有入口识别",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "HallEnterShop",
                    "CommonArkVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 10000,
        "next": [
            "ShopMainPageEntered",
            "__ScenePrivateClickShop"
        ]
    },
    "__ScenePrivateRecoverHallForShop": {
        "desc": "不在商店时回大厅",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "inverse": true, // CommonArkVisible 不命中时才回大厅；父页入口缺失就让外层等到超时，不反复空转
        "next": [
            "SceneEnterHall"
        ]
    }
}
