{
    "SceneEnterHall": {
        "desc": "回大厅，含登录签到", // 已在大厅时直接返回；登录、签到与各种弹窗都沿用 __ScenePrivateRecoverHall 的既有恢复流程
        "timeout": 10000,
        "next": [
            "CommonArkVisible",
            "[JumpBack]__ScenePrivateRecoverHall"
        ]
    },
    "__ScenePrivateRecoverHall": {
        "desc": "仅不在大厅时调用既有完整恢复流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "inverse": true,
        "next": [
            "CommonReturnHall"
        ]
    },
    "SceneEnterArk": {
        "desc": "纯导航到方舟", // 已在方舟时直接返回，不退回大厅
        "timeout": 10000,
        "next": [
            "CommonArkEntered",
            "__ScenePrivateClickArk",
            "[JumpBack]__SceneArkEscapeSubPage", // 方舟子页先点返回，别绕大厅
            "[JumpBack]__ScenePrivateRecoverHallForArk"
        ]
    },
    "__ScenePrivateClickArk": {
        "desc": "点击大厅方舟入口", // 只点大厅的方舟入口，不点左上角层级文字
        "max_hit": 3, // 点击无效时原地重试，3 次后仍未进方舟就交给外层超时
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000, // 方舟首页有入场动画，不等静止会连点第二次
        "timeout": 10000,
        "next": [
            "CommonArkEntered",
            "__ScenePrivateClickArk"
        ]
    },
    "__ScenePrivateRecoverHallForArk": {
        "desc": "不在大厅时回大厅",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "inverse": true, // CommonArkVisible 不命中时才回大厅；父页入口缺失就让外层等到超时，不反复空转
        "next": [
            "SceneEnterHall"
        ]
    }
}
