{
    "SceneEnterFriend": {
        "desc": "纯导航到好友页，不删除好友、接受申请或领取友情点",
        "timeout": 10000,
        "next": [
            "__ScenePrivateFriendPageEntered",
            "__ScenePrivateClickFriend",
            "[JumpBack]__ScenePrivateRecoverHallForFriend"
        ]
    },
    "__ScenePrivateFriendPageEntered": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "FriendManagementOnFriendPage"
                ]
            }
        }
    },
    "__ScenePrivateClickFriend": {
        "desc": "点击大厅好友入口", // 复用 FriendManagementClickFriendEntry 的按钮模板，只点大厅里的好友入口
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "FriendManagementClickFriendEntry",
                    "CommonArkVisible"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 500,
        "timeout": 10000,
        "next": [
            "__ScenePrivateFriendPageEntered",
            "__ScenePrivateClickFriend"
        ]
    },
    "__ScenePrivateRecoverHallForFriend": {
        "desc": "不在好友页时回大厅",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonArkVisible"
                ]
            }
        },
        "inverse": true, // CommonArkVisible 不命中时才回大厅；父页入口缺失就让外层等到超时，不反复空转
        "next": [
            "SceneEnterHall"
        ]
    }
}
