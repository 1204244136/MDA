                    792,
                    293,
                    22,
                    22
                ],
                "template": "Common/RedDot.png",
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                450,
                60,
                380,
                600
            ]
        },
        "next": [
            "CharacterPrepSkillUpgradePageEntered"
        ]
    },
    "CharacterPrepBurstRowUpgradable": {
        "desc": "资讯页爆裂可升级",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    792,
                    454,
                    22,
                    22
                ],
                "template": "Common/RedDot.png",
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                450,
                60,
                380,
                600
            ]
        },
        "next": [
            "CharacterPrepSkillUpgradePageEntered"
        ]
    },
    "CharacterPrepSkillUpgradePageEntered": {
        "desc": "技能升级页已打开",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    80,
                    260,
                    34
                ],
                "expected": [
                    "技能升级"
                ]
            }
        },
        "next": [
            "CharacterPrepClickMaxLevel"
        ]
    },
    "CharacterPrepClickMaxLevel": {
        "desc": "选择升到 LV.10",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    730,
                    545,
                    80,
                    32
                ],
                "expected": [
                    "LV\\.10"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300, // 选完等级后材料栏与按钮要重算
            "target": [
                440,
                590,
                400,
                95
            ]
        },
        "next": [
            "CharacterPrepSkillUpgradeEnabled", // 升级按钮文字是白色＝材料够
            "CharacterPrepSkillLevelTenInsufficient" // 灰色＝材料不够升到 10 级
        ]
    },
    "CharacterPrepSkillUpgradeEnabled": {
        "desc": "升级按钮可用", // 「升级」按钮亮蓝＋白字才可点，不可点时整块变灰、字也变灰
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    650,
                    606,
                    110,
                    36
                ],
                "lower": [
                    210,
                    210,
                    210
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 40
            }
        },
        "next": [
            "CharacterPrepClickSkillUpgrade"
        ]
    },
    "CharacterPrepClickSkillUpgrade": {
        "desc": "点击技能升级",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    600,
                    230,
                    50
                ],
                "expected": [
                    "升级"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CharacterPrepSkillUpgradeDone" // 升级成功后会自动回到技能资讯页，不用点关闭
        ]
    },
    "CharacterPrepSkillUpgradeDone": {
        "desc": "升级后回到资讯页",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    96,
                    260,
                    34
                ],
                "expected": [
                    "技能资讯"
                ]
            }
        },
        "next": [
            "CommonEndTask" // 本段到此结束，回跳后由列表接着做下一个技能
        ]
    },
    "CharacterPrepSkillLevelTenInsufficient": {
        "desc": "材料不足按钮变灰", // 有红点才进得来，灰按钮只可能是材料不足以升到 10 级
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepSkillUpgradePageExit" // 没升级就不会自动返回，得自己关掉升级页
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.SkillLevelTenInsufficient.Succeeded"
        }
    },
    "CharacterPrepSkillUpgradePageExit": {
        "desc": "关闭技能升级页",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonClosePage", // 点掉技能升级页的 X，回到技能资讯页
            "CommonEndTask"
        ]
    },
    "CharacterPrepSkillMaterialShortage": {
        "desc": "材料不足红点消失", // 有红点才点得进来，红点消失只可能是材料被前面的技能吃掉（技能1/2 共用）
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow" // 门禁只记日志，改走统一出口：干净退回角色页再结束本段
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.SkillMaterialShortage.Succeeded"
        }
    },
    "CharacterPrepSkillMaterialsInsufficient": {
        "desc": "技能红点不足三个",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.SkillMaterialsInsufficient.Succeeded"
        }
    }
}
