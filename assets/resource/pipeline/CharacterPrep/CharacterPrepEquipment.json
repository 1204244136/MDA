        },
        "next": [
            "CharacterPrepUpgradeLoop"
        ]
    },
    "CharacterPrepUpgradeLoop": {
        "desc": "升级循环",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepUpgradeReachedFive", // 先识别右侧目标等级
            "[JumpBack]CharacterPrepUpgradeAutoSelect" // 不是 5 级就点自动选择，回跳后重新判定
        ],
        "on_error": [
            "CharacterPrepUpgradeInsufficient"
        ]
    },
    "CharacterPrepUpgradeAutoSelect": {
        "desc": "自动选择升级材料",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    530,
                    586,
                    120,
                    38
                ],
                "expected": [
                    "自动选择"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 600 // 等目标等级刷新后再回跳判定
    },
    "CharacterPrepUpgradeReachedFive": {
        "desc": "目标等级已到5级",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    722,
                    148,
                    66,
                    30
                ],
                "expected": [
                    "LV\\.05"
                ]
            }
        },
        "next": [
            "CharacterPrepClickUpgradeConfirm"
        ]
    },
    "CharacterPrepClickUpgradeConfirm": {
        "desc": "确认升级",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    650,
                    586,
                    110,
                    38
                ],
                "expected": [
                    "升级"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300, // 只等点击生效；结算动画与浮层交给后面的 ENHANCE SUCCEED 判定处理
            "target": [
                360,
                240,
                560,
                250
            ]
        },
        "next": [
            "[JumpBack]CommonConfirmAction",
            "CharacterPrepEnhanceSucceed"
        ]
    },
    "CharacterPrepEnhanceSucceed": {
        "desc": "升级成功提示",
        "recognition": {
            "type": "OCR", // 结算浮层的大字；浮层不点就一直停着，轮询一定能命中，比弹窗里的 LV.05 稳
            "param": {
                "roi": [
                    540,
                    320,
                    210,
                    34
                ],
                "expected": [
                    "ENHANCE"
                ]
            }
        },
        "next": [
            "CharacterPrepUpgradeSettled", // 点过空白回到这里时，先确认浮层已经收起，避免连着点
            "[JumpBack]CommonClickBlank" // 浮层还在就点空白收起：点 ENHANCE SUCCEED 那几个字收不掉
        ]
    },
    "CharacterPrepUpgradeSettled": {
        "desc": "升级结算已结束",
        "recognition": {
            "type": "OCR", // 反相判定：ENHANCE SUCCEED 消失＝浮层收起
            "param": {
                "roi": [
                    540,
                    320,
                    210,
                    34
                ],
                "expected": [
                    "ENHANCE"
                ]
            }
        },
        "inverse": true,
        "post_wait_freezes": {
            "time": 500, // 浮层退回弹窗还有一小段过渡
            "target": [
                455,
                45,
                370,
                670
            ]
        },
        "next": [
            "[JumpBack]CommonConfirmReward", // 溢出返还：先把奖励领掉
            "CharacterPrepClickBreakthrough", // 关掉升级弹窗后，T9 详情页还有「装备改造」按钮
            "[JumpBack]CommonClosePage", // T10 页没有改造入口，关掉弹窗进下一部位
            "[Anchor]CharacterPrepAfterMatched"
        ]
    },
    "CharacterPrepEquipmentFinish": {
        "desc": "装备预热收尾",
        "recognition": {
            "type": "Or", // 两个弹窗都关掉才算收尾完成
            "param": {
                "any_of": [
                    "CharacterPrepUpgradeDialogEntered",
                    "CharacterPrepEquipmentOverload",
                    "CharacterPrepEquipmentTierNine"
                ]
            }
        },
        "inverse": true,
        "next": [
            "CharacterPrepExitFlow" // 收尾也走统一出口：确认回到角色页再结束
        ]
    },
    "CharacterPrepClickBreakthrough": {
        "desc": "点击装备改造",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    470,
                    525,
                    340,
                    165
                ], // 与「升级」同一行，同样随描述/效果行数上下浮动，按弹窗整幅留容差
                "expected": [
                    "装备改造"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 800,
            "target": [
                455,
                45,
                370,
                670
            ]
        }, // 等改造页渲染完，避免按钮颜色还没出来就判材料不足
        "next": [
            "CharacterPrepBreakthroughPageEntered"
        ]
    },
    "CharacterPrepBreakthroughPageEntered": {
        "desc": "装备改造页已打开",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    55,
                    120,
                    30
                ],
                "expected": [
                    "装备改造"
                ]
            }
        },
        "next": [
            "CharacterPrepBreakthroughButtonEnabled",
            "CharacterPrepBreakthroughMaterialsInsufficient"
        ]
    },
    "CharacterPrepBreakthroughButtonEnabled": {
        "desc": "改造材料足够", // 底部大按钮是亮蓝色才可点，材料不足会变灰
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    500,
                    650,
                    260,
                    35
                ],
                "lower": [
                    0,
                    140,
                    220
                ],
                "upper": [
                    120,
                    255,
                    255
                ],
                "count": 500
            }
        },
        "next": [
            "CharacterPrepClickBreakthroughConfirm"
        ]
    },
    "CharacterPrepBreakthroughMaterialsInsufficient": {
        "desc": "改造材料不足",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow" // 门禁只记日志，改走统一出口：干净退回角色页再结束本段
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.BreakthroughMaterialsInsufficient.Succeeded"
        }
    },
    "CharacterPrepClickBreakthroughConfirm": {
        "desc": "确认装备改造",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    470,
                    640,
                    330,
                    55
                ],
                "expected": [
                    "装备改造"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CharacterPrepBreakthroughResultVisible"
        ]
    },
    "CharacterPrepBreakthroughResultVisible": {
        "desc": "改造结算已出现",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    500,
                    170,
                    270,
                    55
                ],
                "expected": [
                    ".*TUNING.*"
                ]
            }
        },
        "next": [
            "CharacterPrepConfirmBreakthroughResult"
        ]
    },
    "CharacterPrepConfirmBreakthroughResult": {
        "desc": "确认改造结果",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    460,
                    200,
                    50
                ],
                "expected": [
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CharacterPrepBreakthroughFinished",
            "CharacterPrepConfirmBreakthroughResult" //兜底
        ]
    },
    "CharacterPrepBreakthroughFinished": {
        "desc": "改造完成回到角色页",
        "recognition": {
            "type": "Or", // 升级弹窗、详情弹窗、改造结算都不在了才算收尾
            "param": {
                "any_of": [
                    "CharacterPrepUpgradeDialogEntered",
                    "CharacterPrepEquipmentOverload",
                    "CharacterPrepEquipmentTierNine",
                    "CharacterPrepBreakthroughResultVisible"
                ]
            }
        },
        "inverse": true,
        "next": [
            "[Anchor]CharacterPrepAfterMatched"
        ]
    },
    "CharacterPrepUpgradeInsufficient": {
        "desc": "升级材料不足",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow" // 门禁只记日志，改走统一出口：干净退回角色页再结束本段
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.UpgradeMaterialsInsufficient.Succeeded"
        }
    }
}
