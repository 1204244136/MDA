            "CharacterPrepCollectibleEntryReread",
            "CharacterPrepExitFlow"
        ]
    },
    "CharacterPrepClickMaintainPage": {
        "desc": "点击保养",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    620,
                    650,
                    220,
                    56
                ], // 保养文字会随页面状态左右移动，ROI 必须覆盖整条按钮带；面板上的「保养」也在这条带里，属可接受的兜底
                "expected": [
                    "保养"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                470,
                240,
                330,
                470
            ]
        },
        "next": [
            "CharacterPrepMaintainPanelVisible",
            "CharacterPrepCancelStaleDialog", // 点在面板上时这一下会开出对话框：认得出来就点取消，别让自环去瞎点第二次
            "CharacterPrepClickMaintainPage"
        ]
    },
    "CharacterPrepMaintainPanelVisible": {
        "desc": "保养面板已展开",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    680,
                    245,
                    170,
                    30
                ],
                "expected": [
                    "非常成功机率"
                ]
            }
        },
        "next": [
            "CharacterPrepCollectibleStep" // 面板已在就直接决策下一步保养
        ]
    },
    "CharacterPrepCollectibleStep": {
        "desc": "收藏品保养决策",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    490,
                    488,
                    110,
                    32
                ],
                "expected": [
                    "\\d+阶段"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CharacterPrepCollectibleDecide",
                "custom_action_param": {
                    "nodes": {
                        "stage_node": "__CharacterPrepCollectibleStage",
                        "exp_node": "__CharacterPrepCollectibleExp",
                        "held_nodes": {
                            "R": "__CharacterPrepCollectibleHeldR",
                            "SR": "__CharacterPrepCollectibleHeldSR",
                            "SSR": "__CharacterPrepCollectibleHeldSSR"
                        },
                        "selected_nodes": {
                            "R": "__CharacterPrepSelectedR",
                            "SR": "__CharacterPrepSelectedSR",
                            "SSR": "__CharacterPrepSelectedSSR"
                        },
                        "pick_nodes": {
                            "R": "CharacterPrepCollectiblePickR",
                            "SR": "CharacterPrepCollectiblePickSR",
                            "SSR": "CharacterPrepCollectiblePickSSR"
                        }
                    },
                    "maxed_node": "CharacterPrepCollectibleMaxed",
                    "no_material_node": "CharacterPrepCollectibleOutOfBox"
                }
            }
        },
        "next": [
            // 动作正常时总会改写下一步；这里只是别让节点没有 next
            "CharacterPrepMaintainPanelVisible"
        ]
    },
