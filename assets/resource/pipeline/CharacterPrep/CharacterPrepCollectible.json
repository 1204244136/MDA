    "CharacterPrepCollectibleUseEnabled": {
        "desc": "使用按钮可用",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    660,
                    655,
                    110,
                    33
                ],
                "lower": [
                    230,
                    230,
                    230
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 40
            }
        },
        "next": [
            "CharacterPrepClickCollectibleUse"
        ]
    },
    "CharacterPrepClickCollectibleUse": {
