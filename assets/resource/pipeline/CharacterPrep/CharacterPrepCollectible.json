        },
        "post_delay": 400,
        "timeout": 60000, // 点完保养到动画播完要几秒到十几秒，默认 20s 预算不够会中途判失败
        "next": [
            "[JumpBack]CharacterPrepMaintainNotice", // 确认保养后可能弹区间提示（MAX 跨区间时），点掉它再回到本列表继续
            // 关掉对话框后三卡面板会先亮一下（材质还没扣），这里不认面板，只认保养真正开跑/跑完的信号
            "CharacterPrepMaintainMinigame",
            "CharacterPrepMaintainAnimContinue",
            "CharacterPrepMaintainDone",
            "CharacterPrepConfirmMaintain"
        ]
    },
    "CharacterPrepMaintainNotice": {
        "desc": "保养区间提示",
        "recognition": {
            "type": "And",
            "param": {
                // 确认按钮放首位：点击框取 all_of[0]，点「确认」而不是文案
                "all_of": [
                    "__CharacterPrepNoticeConfirmButton",
                    "__CharacterPrepNoticeText"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
        // 故意不写 next：它只作为调用者的 [JumpBack] 目标，点完确认即结束、自然回到调用者的列表
    },
    "__CharacterPrepNoticeText": {
        "desc": "区间提示文案",
        "recognition": {
