{
    "CharacterPrepCollectibleFlow": {
        "desc": "收藏品预热",
        "max_hit": 1,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__CharacterPrepCollectibleOnDetail",
                    "__CharacterPrepCollectibleOnPage"
                ]
            }
        },
        "next": [
            "CharacterPrepCollectibleEntry"
        ]
    },
    "CharacterPrepClickCollectiblePlus": {
        "desc": "点击收藏品加号",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    90,
                    90,
                    110
                ],
                "template": "CharacterPrep/Collectible/CollectiblePlus.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                300,
                60,
                680,
                600
            ]
        },
        "next": [
            "CharacterPrepCollectiblePageEntered",
            "CharacterPrepClickCollectiblePlus"
        ]
    },
    "CharacterPrepCollectiblePageEntered": {
        "desc": "收藏品页已打开",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    8,
                    90,
                    28
                ],
                "expected": [
                    "收藏品"
                ]
            }
        },
        "next": [
            "CharacterPrepClickCollectibleCard",
            "CharacterPrepCollectiblePageEntered" //兜底
        ]
    },
    "CharacterPrepClickCollectibleCard": {
        "desc": "点击收藏品展示位",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    460,
                    530,
                    360,
                    80
                ],
                "expected": [
                    "装备并.*保养收藏品"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    48,
                    -260,
                    -111,
                    -11
                ]
            }
        },
        "next": [
            "CharacterPrepCollectibleSelectEntered",
            "CharacterPrepClickCollectibleCard" //兜底
        ]
    },
    "CharacterPrepCollectibleSelectEntered": {
        "desc": "选择收藏品页已打开",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    32,
                    220,
                    40
                ],
                "expected": [
                    "选择收藏品"
                ]
            }
        },
        "timeout": 8000, // 给持有数读数留几轮；两个判据都读不到就按节点失败处理，不做兜底
        "next": [
            // 只认「持有数 > 0」和「持有数 = 0」两种明确判据；读不出来就让它自己报错
            "CharacterPrepCollectibleHasSR",
            "CharacterPrepCollectibleSRCountZero"
        ]
    },
    "CharacterPrepCollectibleSRCountZero": {
        "desc": "SR持有数为零",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CharacterPrepCollectibleSRBadge",
