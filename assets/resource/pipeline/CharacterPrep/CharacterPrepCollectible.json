    "CharacterPrepCollectibleNoSRCard": {
        "desc": "没有SR藏品可升级",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.CollectibleNoSRCard.Succeeded"
        }
    },
    "CharacterPrepCollectibleOutOfBox": {
        "desc": "三档工具箱都不足",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "CharacterPrepExitFlow"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.CharacterPrep.CollectibleOutOfBox.Succeeded"
        }
    },
    "CharacterPrepCollectibleSRCount": {
        "desc": "SR卡持有数",
        "recognition": {
            "type": "OCR",
